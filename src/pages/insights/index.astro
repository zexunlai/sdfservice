---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = `${import.meta.env.BASE_URL}/`;
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const entries = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.getTime() - a.data.publicationDate.getTime());
---

<BaseLayout title="Insights" description="Articles and analysis across the five areas of this environmental intelligence platform.">
  <header class="page-intro container"><span class="eyebrow">Insights</span><h1>Articles and analysis.</h1><p>Long-form writing that examines public frameworks and connects environmental evidence with decisions.</p></header>
  <section class="section"><div class="container"><div class="articles">{entries.map(article=><article><div class="meta"><span>{article.data.area}</span><time datetime={article.data.publicationDate.toISOString()}>{dateFormat.format(article.data.publicationDate)}</time></div><h2><a href={`${base}insights/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={`${base}insights/${article.id}/`}>Read article →</a></article>)}</div>{!entries.length&&<p class="empty">No published articles yet.</p>}</div></section>
  <section class="section methodology"><div class="container"><span class="eyebrow">Reference system</span><div><h2>Methods & Resources Library</h2><p>Original analyses connected with verified public resources.</p><a class="text-link" href={`${base}library/`}>Explore the library →</a></div></div></section>
</BaseLayout>
<style>.articles{display:grid;grid-template-columns:1fr 1fr;gap:0 36px}.articles article{padding:25px 0 32px;border-top:1px solid var(--line)}.articles h2{font-size:clamp(1.65rem,3vw,2.55rem)}.articles h2 a,.read{text-decoration:none}.articles p{color:var(--muted);max-width:58ch}.read{font-size:.76rem;font-weight:700;text-transform:uppercase;color:var(--accent)}.methodology{background:var(--paper-2)}.methodology .container{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.methodology p{max-width:60ch;color:var(--muted)}.empty{padding:35px 0;color:var(--muted)}@media(max-width:700px){.articles,.methodology .container{grid-template-columns:1fr}}</style>
