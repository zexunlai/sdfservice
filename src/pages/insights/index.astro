---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {expertise} from '../../config/expertise'; import {getPublishedArticles} from '../../lib/platform-data';
export const prerender=false;const area=Astro.url.searchParams.get('area')??'';const q=(Astro.url.searchParams.get('q')??'').trim();let entries=await getPublishedArticles(Astro.locals,'en');if(area)entries=entries.filter(x=>x.areaKey===area||x.area===expertise.find(a=>a.slug===area)?.title);if(q)entries=entries.filter(x=>`${x.title} ${x.summary} ${(x.tags??[]).join(' ')}`.toLowerCase().includes(q.toLowerCase()));const dateFormat=new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'});
---
<BaseLayout title="Insights" description="Articles and analysis across the five areas of this environmental intelligence platform."><header class="page-intro container"><span class="eyebrow">Insights</span><h1>Articles and analysis.</h1><p>Long-form writing that examines public frameworks and connects environmental evidence with decisions.</p></header><section class="section"><div class="container"><form class="filters" method="get" role="search"><label><span>Search</span><input type="search" name="q" value={q} placeholder="Search articles"></label><label><span>Area</span><select name="area"><option value="">All areas</option>{expertise.map(x=><option value={x.slug} selected={area===x.slug}>{x.title}</option>)}</select></label><button>Apply filters</button></form><div class="articles">{entries.map(article=><article><div class="meta"><span>{article.area}</span><time datetime={article.publicationDate}>{dateFormat.format(new Date(`${article.publicationDate}T00:00:00`))}</time></div><h2><a href={`/insights/${article.slug}/`}>{article.title}</a></h2><p>{article.summary}</p><a class="read" href={`/insights/${article.slug}/`}>Read article →</a></article>)}</div>{!entries.length&&<p class="empty">No published articles match these filters.</p>}</div></section><section class="section methodology"><div class="container"><span class="eyebrow">Reference system</span><div><h2>Methods & Resources Library</h2><p>Original analyses connected with verified official resources.</p><a class="text-link" href="/library/">Explore the library →</a></div></div></section></BaseLayout>
<style>.filters{display:grid;grid-template-columns:2fr 1.5fr auto;gap:12px;align-items:end;margin-bottom:42px}.filters label{display:grid;gap:5px}.filters label span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.filters input,.filters select,.filters button{min-height:43px;padding:9px;border:1px solid var(--line);background:white;font:inherit}.filters button{background:var(--forest);color:white}.articles{display:grid;grid-template-columns:1fr 1fr;gap:0 36px}.articles article{padding:25px 0 32px;border-top:1px solid var(--line)}.articles h2{font-size:clamp(1.65rem,3vw,2.55rem)}.articles h2 a,.read{text-decoration:none}.articles p{color:var(--muted);max-width:58ch}.read{font-size:.76rem;font-weight:600;text-transform:uppercase}.methodology{background:var(--paper-2)}.methodology .container{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.methodology p{max-width:60ch;color:var(--muted)}.empty{padding:35px 0;color:var(--muted)}@media(max-width:700px){.articles,.methodology .container,.filters{grid-template-columns:1fr}}</style>
