---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content';
const entries=(await getCollection('insights',({data})=>!data.draft)).sort((a,b)=>(b.data.date?.valueOf()??0)-(a.data.date?.valueOf()??0));
const filters=['All','Carbon Markets','Carbon Methodologies','GIS & Remote Sensing','Biodiversity & Nature','Circular Economy','Climate & Sustainability','Research Notes'];
function group(data:typeof entries[number]['data']){const text=`${data.title} ${data.category} ${data.tags.join(' ')}`.toLowerCase();if(text.includes('methodolog')||text.includes('additionality')||text.includes('mrv'))return 'Carbon Methodologies';if(text.includes('carbon'))return 'Carbon Markets';if(text.includes('gis')||text.includes('geospatial')||text.includes('remote sensing'))return 'GIS & Remote Sensing';if(text.includes('biodiversity')||text.includes('nature'))return 'Biodiversity & Nature';if(text.includes('circular'))return 'Circular Economy';if(text.includes('climate')||text.includes('sustainability'))return 'Climate & Sustainability';return 'Research Notes'}
---
<BaseLayout title="Insights" description="Notes and analysis across geospatial intelligence, sustainability, nature, circular economy and carbon markets."><header class="page-intro container"><span class="eyebrow">Insights</span><h1>Notes and analysis.</h1><p>Notes and analysis across geospatial intelligence, sustainability, nature, circular economy and carbon markets.</p></header><section class="container explore"><span>Explore</span><a href="#articles">Articles</a><a href="#articles" data-filter-link="Research Notes">Research Notes</a><a href="/methodologies/">Carbon Methodology Library →</a></section><section class="section" id="articles"><div class="container"><div class="filters" role="group" aria-label="Filter insights">{filters.map((filter,i)=><button type="button" data-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}</button>)}</div><div class="articles">{entries.map(({id,data})=><article data-group={group(data)}><div class="meta"><span>{group(data)}</span>{data.date?<time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en-GB',{year:'numeric',month:'short'})}</time>:<span>Essay</span>}</div><h2><a href={`/insights/${id}/`}>{data.title}</a></h2><p>{data.description}</p><a class="read" href={`/insights/${id}/`}>Read insight →</a></article>)}</div><p id="empty" hidden>No published insights are available in this category yet.</p></div></section><section class="section methodology"><div class="container"><span class="eyebrow">Specialised library</span><div><h2>Carbon Methodology Library</h2><p>A structured space for reviewed methodology information. The library remains intentionally small while entries are being verified against official sources.</p><a class="text-link" href="/methodologies/">Explore the library →</a></div></div></section><script>const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];const articles=[...document.querySelectorAll<HTMLElement>('.articles article')];const empty=document.querySelector<HTMLElement>('#empty');function apply(value:string){let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===value)));articles.forEach(a=>{const show=value==='All'||a.dataset.group===value;a.hidden=!show;if(show)count++});if(empty)empty.hidden=count>0}buttons.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.filter??'All')));document.querySelector('[data-filter-link]')?.addEventListener('click',()=>apply('Research Notes'));</script></BaseLayout>
<style>.explore{display:flex;gap:22px;flex-wrap:wrap;border-top:1px solid var(--ink);padding:18px 0 55px}.explore span{font-size:.74rem;text-transform:uppercase;letter-spacing:.12em;margin-right:auto}.explore a{font-size:.84rem}.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:42px}.filters button{border:0;border-bottom:1px solid transparent;background:transparent;padding:7px 5px;color:var(--muted);font:inherit;font-size:.8rem;cursor:pointer}.filters button[aria-pressed=true]{color:var(--ink);border-color:var(--forest)}.articles{display:grid;grid-template-columns:1fr 1fr;gap:0 36px}.articles article{padding:25px 0 32px;border-top:1px solid var(--line)}.articles h2{font-size:clamp(1.65rem,3vw,2.55rem)}.articles h2 a,.read{text-decoration:none}.articles p{color:var(--muted);max-width:58ch}.read{font-size:.76rem;font-weight:600;text-transform:uppercase}.methodology{background:var(--paper-2)}.methodology .container{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.methodology p{max-width:60ch;color:var(--muted)}#empty{padding:35px 0;color:var(--muted)}@media(max-width:700px){.explore{display:grid;grid-template-columns:1fr 1fr}.explore span{grid-column:1/-1}.articles,.methodology .container{grid-template-columns:1fr}.filters{gap:3px 12px}}</style>
