---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content'; import {expertise} from '../../config/expertise'; const entries=(await getCollection('insights',({data})=>!data.draft)).sort((a,b)=>b.data.publicationDate.valueOf()-a.data.publicationDate.valueOf()); const dateFormat=new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'}); const filters=['All',...expertise.map(x=>x.title)];
---
<BaseLayout title="Insights" description="Articles and analysis across the five areas of this environmental intelligence platform."><header class="page-intro container"><span class="eyebrow">Insights</span><h1>Articles and analysis.</h1><p>Long-form writing that develops ideas, examines public frameworks and connects environmental evidence with decisions.</p></header><section class="section" id="articles"><div class="container"><div class="filters" role="group" aria-label="Filter articles by expertise area">{filters.map((filter,i)=><button type="button" data-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}</button>)}</div><div class="articles">{entries.map(({id,data})=><article data-area={data.area}><div class="meta"><span>{data.area}</span><time datetime={data.publicationDate.toISOString()}>{dateFormat.format(data.publicationDate)}</time></div><h2><a href={`/insights/${id}/`}>{data.title}</a></h2><p>{data.description}</p><a class="read" href={`/insights/${id}/`}>Read article →</a></article>)}</div><p id="empty" hidden>No published articles are available in this area yet.</p></div></section><section class="section methodology"><div class="container"><span class="eyebrow">Specialised library</span><div><h2>Methodology Library</h2><p>A structured library of methods, frameworks and standards used across environmental analysis and decision-making.</p><a class="text-link" href="/library/">Explore the library →</a></div></div></section><script>const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];const articles=[...document.querySelectorAll<HTMLElement>('.articles article')];const empty=document.querySelector<HTMLElement>('#empty');function apply(value:string){let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===value)));articles.forEach(a=>{const show=value==='All'||a.dataset.area===value;a.hidden=!show;if(show)count++});if(empty)empty.hidden=count>0}buttons.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.filter??'All')));</script></BaseLayout>
<style>.filters{display:flex;gap:7px 14px;flex-wrap:wrap;margin-bottom:42px}.filters button{border:0;border-bottom:1px solid transparent;background:transparent;padding:7px 3px;color:var(--muted);font:inherit;font-size:.8rem;cursor:pointer}.filters button[aria-pressed=true]{color:var(--ink);border-color:var(--forest)}.articles{display:grid;grid-template-columns:1fr 1fr;gap:0 36px}.articles article{padding:25px 0 32px;border-top:1px solid var(--line)}.articles h2{font-size:clamp(1.65rem,3vw,2.55rem)}.articles h2 a,.read{text-decoration:none}.articles p{color:var(--muted);max-width:58ch}.read{font-size:.76rem;font-weight:600;text-transform:uppercase}.methodology{background:var(--paper-2)}.methodology .container{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.methodology p{max-width:60ch;color:var(--muted)}#empty{padding:35px 0;color:var(--muted)}@media(max-width:700px){.articles,.methodology .container{grid-template-columns:1fr}.filters{gap:3px 10px}}</style>
