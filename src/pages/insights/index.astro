---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content';
const entries=(await getCollection('insights',({data})=>!data.draft)).sort((a,b)=>(b.data.date?.valueOf()??0)-(a.data.date?.valueOf()??0)); const categories=[...new Set(entries.map(x=>x.data.category))];
---
<BaseLayout title="Insights" description="Essays on geospatial intelligence, sustainability, biodiversity, circular economy and carbon markets."><header class="page-intro container"><span class="eyebrow">Insights</span><h1>Ideas, frameworks and field notes.</h1><p>Public writing about how environmental questions can be structured, measured and understood across disciplines.</p></header><section class="container listing"><div class="filters"><label><span>Search</span><input id="search" type="search" placeholder="Search insights"/></label><label><span>Topic</span><select id="category"><option value="">All topics</option>{categories.map(x=><option value={x}>{x}</option>)}</select></label></div><div id="entries">{entries.map(({id,data})=><article data-category={data.category} data-search={`${data.title} ${data.description} ${data.tags.join(' ')}`.toLowerCase()}><div class="meta"><span>{data.category}</span>{data.date&&<time>{data.date.getFullYear()}</time>}</div><a href={`/insights/${id}/`}><h2>{data.title}</h2></a><p>{data.description}</p><div>{data.tags.slice(0,3).map(x=><span class="tag">{x}</span>)}</div></article>)}</div><p id="empty" hidden>No published insights match these filters.</p></section><script>const search=document.querySelector<HTMLInputElement>('#search');const category=document.querySelector<HTMLSelectElement>('#category');const cards=[...document.querySelectorAll<HTMLElement>('#entries article')];const empty=document.querySelector<HTMLElement>('#empty');function filter(){const q=search?.value.trim().toLowerCase()??'';const c=category?.value??'';let visible=0;cards.forEach(card=>{const show=(!q||card.dataset.search?.includes(q))&&(!c||card.dataset.category===c);card.hidden=!show;if(show)visible++});if(empty)empty.hidden=visible>0}search?.addEventListener('input',filter);category?.addEventListener('change',filter);</script></BaseLayout>
<style>.listing{padding-bottom:120px}.filters{display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:20px 0 50px;border-top:1px solid var(--ink)}label span{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}input,select{width:100%;font:inherit;background:transparent;border:1px solid var(--line);border-radius:0;padding:12px;color:var(--ink)}article{display:grid;grid-template-columns:1fr 2fr 1.2fr;gap:30px;padding:32px 0;border-top:1px solid var(--line)}article h2{font-size:clamp(1.7rem,3vw,2.6rem)}article a{text-decoration:none}article p{color:var(--muted)}#empty{padding:40px 0;color:var(--muted)}@media(max-width:720px){.filters,article{grid-template-columns:1fr}.meta{margin:0}article p{margin:0}}</style>
