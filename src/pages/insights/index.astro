---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { expertise } from '../../config/expertise';
import insightData from '../../data/pdf-insights.json';
import type { PdfInsight } from '../../types/insights';
const insights=insightData as PdfInsight[];
const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;
const dateFormat=new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'});
---
<BaseLayout title="Insights" description="PDF insights across five areas of environmental intelligence."><header class="page-intro container"><span class="eyebrow">Insights</span><h1>Research PDFs and briefings.</h1><p>Original PDF work organised across five connected areas of environmental intelligence.</p></header><section class="section"><div class="container"><div class="filters" aria-label="Filter insights"><label><span>Search</span><input id="insight-search" type="search" placeholder="Search PDFs"></label><div class="area-filter"><span>Area</span><div role="group" aria-label="Filter by area"><button class="filter active" data-area="all">All areas</button>{expertise.map(area=><button class="filter" data-area={area.slug}>{area.title}</button>)}</div></div></div><div class="articles" id="insight-list">{insights.map(item=><article data-area={item.areaKey} data-search={`${item.title} ${item.area}`.toLowerCase()}><div class="meta"><span>{item.area}</span>{item.date&&<time datetime={item.date}>{dateFormat.format(new Date(`${item.date}T00:00:00`))}</time>}</div><h2>{item.title}</h2><a class="read" href={`${base}insights/${item.file}`} target="_blank" rel="noreferrer">Open PDF ↗</a></article>)}</div><p class="empty" id="insight-empty" hidden>No PDF insights match this filter.</p>{!insights.length&&<p class="empty">No PDF insights have been published yet.</p>}</div></section><section class="section methodology"><div class="container"><span class="eyebrow">Reference system</span><div><h2>Methods & Resources Library</h2><p>Methodology analyses and verified external official sources.</p><a class="text-link" href={`${base}library/`}>Explore the library →</a></div></div></section></BaseLayout>
<script is:inline>const search=document.querySelector('#insight-search'),buttons=[...document.querySelectorAll('.filter')],cards=[...document.querySelectorAll('#insight-list article')],empty=document.querySelector('#insight-empty');let area='all';function filter(){const term=search.value.trim().toLowerCase();let shown=0;cards.forEach(card=>{const match=(area==='all'||card.dataset.area===area)&&card.dataset.search.includes(term);card.hidden=!match;if(match)shown++});empty.hidden=shown!==0}buttons.forEach(button=>button.addEventListener('click',()=>{area=button.dataset.area;buttons.forEach(item=>item.classList.toggle('active',item===button));filter()}));search?.addEventListener('input',filter);</script>
<style>.filters{display:grid;grid-template-columns:1fr 2fr;gap:26px;align-items:end;margin-bottom:42px}.filters label,.area-filter{display:grid;gap:7px}.filters span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.filters input{min-height:43px;padding:9px;border:1px solid var(--line);background:white;font:inherit}.area-filter>div{display:flex;gap:8px;flex-wrap:wrap}.filter{border:1px solid var(--line);background:transparent;padding:8px 11px;font:inherit;font-size:.78rem;cursor:pointer}.filter.active,.filter:hover{border-color:var(--forest);background:var(--forest);color:white}.articles{display:grid;grid-template-columns:1fr 1fr;gap:0 36px}.articles article{padding:25px 0 32px;border-top:1px solid var(--line)}.articles h2{font-size:clamp(1.65rem,3vw,2.55rem)}.read{text-decoration:none;font-size:.76rem;font-weight:600;text-transform:uppercase}.methodology{background:var(--paper-2)}.methodology .container{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.methodology p,.empty{color:var(--muted)}@media(max-width:700px){.filters,.articles,.methodology .container{grid-template-columns:1fr}}</style>
