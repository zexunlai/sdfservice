---
import BaseLayout from '../layouts/BaseLayout.astro'; import {expertise} from '../config/expertise'; const languages=['Chinese','English','Taiwanese','Japanese']; const tools=['GIS','Remote Sensing','Excel','R','Environmental Data Analysis'];
---
<BaseLayout title="About Ze-Xun Lai | Environmental Intelligence" description="Professional background, education and expertise of Ze-Xun Lai."><header class="page-intro container"><span class="eyebrow">About</span><h1>Ze-Xun Lai</h1><p>A sustainability professional working across {expertise.map(x=>x.title).join(', ')}.</p></header><section class="section"><div class="container two"><span class="eyebrow">Profile</span><div class="prose"><p>My professional background combines sustainability consulting with a foundation in geography and spatial analysis. I am particularly interested in connecting environmental frameworks with data, spatial context and practical decision-making.</p></div></div></section><section class="section experience"><div class="container two"><span class="eyebrow">Professional experience</span><div><h2>PwC Taiwan</h2><p class="practice">Sustainability & Climate Change</p><div class="timeline"><article><time>2026–Present</time><h3>Senior Associate</h3></article><article><time>2024–2026</time><h3>Associate</h3></article></div><p class="scope">Working across corporate sustainability, climate-related disclosure, greenhouse-gas management, transition planning, nature-related topics, circular economy and sustainability data, with experience applying international sustainability frameworks and standards across analysis, reporting and implementation contexts.</p><p class="frameworks">Public frameworks and standards include IFRS S1, IFRS S2, TCFD, TNFD, CDP, SBTi, GRI, SASB, ISO 14001 and ISO 59020.</p></div></div></section><section class="section education"><div class="container two"><span class="eyebrow">Education</span><div><h2>National Taiwan University</h2><h3>B.Sc. in Geography</h3><p>My academic training in geography developed a foundation in spatial thinking, GIS, remote sensing, environmental systems, climate, statistics and data analysis. This background continues to shape how I approach sustainability issues, particularly where location, environmental conditions and spatial relationships influence environmental and business outcomes.</p></div></div></section><section class="section"><div class="container two"><span class="eyebrow">Languages & tools</span><div class="final-grid"><div><h3>Languages</h3>{languages.map(x=><span>{x}</span>)}</div><div><h3>Tools & methods</h3>{tools.map(x=><span>{x}</span>)}</div></div></div></section><section class="section connect"><div class="container two"><span class="eyebrow">Connect</span><div><h2>Interested in working across the same questions?</h2><a class="button" href="/contact/">Let’s connect →</a></div></div></section></BaseLayout>
<style>.two{display:grid;grid-template-columns:1fr 2fr;gap:7vw}.two h2{margin-bottom:8px}.experience,.education{background:var(--paper-2)}.practice{color:var(--forest);font-weight:600}.timeline{margin:35px 0}.timeline article{display:grid;grid-template-columns:150px 1fr;padding:17px 0;border-top:1px solid var(--line)}.timeline time{color:var(--muted);font-size:.84rem}.timeline h3{font-size:1.5rem}.scope,.frameworks,.education p{max-width:65ch;color:var(--muted)}.frameworks{font-size:.88rem}.education h3{margin:12px 0 30px}.final-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px}.final-grid h3{margin-bottom:18px}.final-grid span{display:block;padding:9px 0;border-top:1px solid var(--line)}.connect h2{margin-bottom:28px}@media(max-width:700px){.two,.final-grid{grid-template-columns:1fr}.timeline article{grid-template-columns:110px 1fr}}</style>
