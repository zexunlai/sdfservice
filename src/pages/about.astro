---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About Zexun Lai: a sustainability professional with a geographic perspective on environmental systems."><header class="page-intro container"><span class="eyebrow">About</span><h1>Environmental thinking begins with relationships.</h1></header><section class="section"><div class="container about"><div class="geo-panel portrait"><span>25°N</span><strong>Geography<br/>as a way<br/>of seeing.</strong><span>121°E</span></div><div class="prose"><p>A sustainability professional working at the intersection of geospatial analysis, climate, biodiversity, circular economy and carbon markets.</p><p>My work and research interests focus on understanding how environmental challenges can be translated into measurable risks, spatial patterns, management frameworks and practical decision-making tools.</p><p>With a background in geography, I am particularly interested in how location, environmental systems and spatial data can strengthen sustainability analysis.</p></div></div></section><section class="section education"><div class="container layout"><span class="eyebrow">Education</span><div><h2>B.Sc. in Geography</h2><p>National Taiwan University</p></div></div></section><section class="section"><div class="container layout"><span class="eyebrow">Foundation</span><div class="subjects">{['Spatial thinking','Environmental systems','GIS','Remote sensing','Data analysis','Climate','Human–environment interactions'].map(x=><span>{x}</span>)}</div></div></section></BaseLayout>
<style>.about{display:grid;grid-template-columns:1fr 1.2fr;gap:8vw}.portrait{min-height:520px;padding:28px;display:flex;flex-direction:column;justify-content:space-between}.portrait strong{font-family:var(--serif);font-size:clamp(2rem,5vw,4rem);font-weight:400}.portrait span{font-size:.72rem;letter-spacing:.15em}.layout{display:grid;grid-template-columns:1fr 2fr;gap:50px}.education{background:var(--paper-2)}.education p{color:var(--muted);margin-top:10px}.subjects{display:grid;grid-template-columns:1fr 1fr}.subjects span{border-top:1px solid var(--line);padding:15px 0}@media(max-width:700px){.about,.layout{grid-template-columns:1fr}.portrait{min-height:360px}.subjects{grid-template-columns:1fr}}</style>
