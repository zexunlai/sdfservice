---
import BaseLayout from '../layouts/BaseLayout.astro';import {getSiteSection} from '../lib/platform-data';import {createPublicClient} from '../lib/supabase';
export const prerender=false;const profile=await getSiteSection(Astro.locals,'about','profile','en');const db=createPublicClient(Astro.locals);let items:any[]=[];if(db){const{data}=await db.from('profile_items').select('*').eq('locale','en').eq('active',true).order('kind').order('sort_order');items=data??[];}if(!items.length)items=[{kind:'education',title:'B.Sc. in Geography',organisation:'National Taiwan University',summary:'Academic training in spatial thinking, GIS, remote sensing, environmental systems, climate, statistics and data analysis.'},...['Chinese','English','Taiwanese','Japanese'].map(title=>({kind:'language',title})),...['GIS','Remote Sensing','Excel','R','Environmental Data Analysis'].map(title=>({kind:'tool',title}))];const byKind=(kind:string)=>items.filter(x=>x.kind===kind);
---
<BaseLayout title="About Ze-Xun Lai | Environmental Intelligence" description="Professional background, education and expertise of Ze-Xun Lai."><header class="page-intro container"><span class="eyebrow">{profile?.eyebrow??'About'}</span><h1>{profile?.heading??'Ze-Xun Lai'}</h1><p>{profile?.profile??'A sustainability professional with a background in geography and spatial analysis.'}</p></header><section class="section"><div class="container two"><span class="eyebrow">Profile</span><div class="prose"><p>{profile?.approach??'My work connects environmental frameworks with data, spatial context and practical decision-making.'}</p></div></div></section>{byKind('experience').length>0&&<section class="section experience"><div class="container two"><span class="eyebrow">Professional experience</span><div class="timeline">{byKind('experience').map(item=><article><time>{[item.start_label,item.end_label].filter(Boolean).join('–')}</time><div><h3>{item.title}</h3><strong>{item.organisation}</strong>{item.summary&&<p>{item.summary}</p>}</div></article>)}</div></div></section>}{byKind('education').length>0&&<section class="section education"><div class="container two"><span class="eyebrow">Education</span><div>{byKind('education').map(item=><article><h2>{item.organisation}</h2><h3>{item.title}</h3>{item.summary&&<p>{item.summary}</p>}</article>)}</div></div></section>}{(byKind('teaching').length>0||byKind('credential').length>0)&&<section class="section"><div class="container two"><span class="eyebrow">Additional experience</span><div>{[...byKind('teaching'),...byKind('credential')].map(item=><article class="listed"><h3>{item.title}</h3><p>{item.organisation}{item.summary&&` · ${item.summary}`}</p></article>)}</div></div></section>}<section class="section"><div class="container two"><span class="eyebrow">Languages & tools</span><div class="final-grid"><div><h3>Languages</h3>{byKind('language').map(x=><span>{x.title}</span>)}</div><div><h3>Tools & methods</h3>{byKind('tool').map(x=><span>{x.title}</span>)}</div></div></div></section><section class="section connect"><div class="container two"><span class="eyebrow">Connect</span><div><h2>Interested in working across the same questions?</h2><a class="button" href="/contact/">Let’s connect →</a></div></div></section></BaseLayout>
<style>.two{display:grid;grid-template-columns:1fr 2fr;gap:7vw}.experience,.education{background:var(--paper-2)}.timeline article{display:grid;grid-template-columns:150px 1fr;padding:20px 0;border-top:1px solid var(--line)}.timeline time{color:var(--muted);font-size:.84rem}.timeline h3{font-size:1.5rem}.timeline p,.education p,.listed p{color:var(--muted);max-width:65ch}.education h3{margin:12px 0 25px}.final-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px}.final-grid h3{margin-bottom:18px}.final-grid span,.listed{display:block;padding:9px 0;border-top:1px solid var(--line)}.connect h2{margin-bottom:28px}@media(max-width:700px){.two,.final-grid{grid-template-columns:1fr}.timeline article{grid-template-columns:110px 1fr}}</style>
