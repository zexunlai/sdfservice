---
import BaseLayout from '../layouts/BaseLayout.astro';const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;
---
<BaseLayout title="About Ze-Xun Lai | Environmental Intelligence" description="Professional background, education and expertise of Ze-Xun Lai."><header class="page-intro container"><span class="eyebrow">About</span><h1>Ze-Xun Lai</h1><p>A sustainability professional with a background in geography and spatial analysis.</p></header><section class="section"><div class="container two"><span class="eyebrow">Profile</span><div class="prose"><p>My work connects environmental frameworks with data, spatial context and practical decision-making.</p></div></div></section><section class="section education"><div class="container two"><span class="eyebrow">Education</span><div><h2>National Taiwan University</h2><h3>B.Sc. in Geography</h3><p>Academic training in spatial thinking, GIS, remote sensing, environmental systems, climate, statistics and data analysis.</p></div></div></section><section class="section"><div class="container two"><span class="eyebrow">Languages & tools</span><div class="final-grid"><div><h3>Languages</h3>{['Chinese','English','Taiwanese','Japanese'].map(x=><span>{x}</span>)}</div><div><h3>Tools & methods</h3>{['GIS','Remote Sensing','Excel','R','Environmental Data Analysis'].map(x=><span>{x}</span>)}</div></div></div></section><section class="section connect"><div class="container two"><span class="eyebrow">Connect</span><div><h2>Interested in working across the same questions?</h2><a class="button" href={`${base}contact/`}>Let’s connect</a></div></div></section></BaseLayout>
<style>.two{display:grid;grid-template-columns:1fr 2fr;gap:7vw}.education{background:var(--paper-2)}.education h3{margin:12px 0 25px}.education p{color:var(--muted);max-width:65ch}.final-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px}.final-grid h3{margin-bottom:18px}.final-grid span{display:block;padding:9px 0;border-top:1px solid var(--line)}.connect h2{margin-bottom:28px}@media(max-width:700px){.two,.final-grid{grid-template-columns:1fr}}</style>
