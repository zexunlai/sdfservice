---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content'; const research=await getCollection('research',({data})=>!data.draft); const projects=await getCollection('projects',({data})=>!data.draft); const foundations=['Spatial thinking','Environmental systems','GIS','Remote sensing','Data analysis','Climate','Human–environment interactions']; const tools=['GIS and spatial analysis','Remote sensing','Environmental datasets','GHG Protocol','TNFD and LEAP','IFRS S1 and S2','Circular economy standards','Carbon-crediting methodologies'];
---
<BaseLayout title="About" description="About Ze-Xun Lai: a sustainability professional with a geographic perspective on environmental systems."><header class="page-intro container"><span class="eyebrow">About</span><h1>Environmental thinking begins with relationships.</h1></header><section class="section profile"><div class="container two"><span class="eyebrow">Profile</span><div class="prose"><p>A sustainability professional working at the intersection of geospatial analysis, climate, biodiversity, circular economy and carbon markets.</p><p>My work and research interests focus on understanding how environmental challenges can be translated into measurable risks, spatial patterns, management frameworks and practical decision-making tools.</p></div></div></section><section class="section background"><div class="container two"><span class="eyebrow">Background</span><div><h2>A geographic perspective.</h2><p>With a background in geography, I am particularly interested in how location, environmental systems and spatial data can strengthen sustainability analysis.</p></div></div></section><section class="section"><div class="container two"><span class="eyebrow">How I think</span><div><h2>Connect place, evidence and decisions.</h2><p class="lead">Environmental questions become more useful when their scale, assumptions and relationships are visible. I use spatial thinking and structured frameworks to connect environmental conditions with practical choices.</p></div></div></section><section class="section education"><div class="container two"><span class="eyebrow">Education</span><div><h2>B.Sc. in Geography</h2><p>National Taiwan University</p><div class="terms">{foundations.map(x=><span>{x}</span>)}</div></div></div></section><section class="section" id="research"><div class="container two"><div><span class="eyebrow">Research interests</span><h2>Currently exploring.</h2></div><ol class="research">{research.map((entry,i)=><li><span>0{i+1}</span><div><strong>{entry.data.title}</strong><p>{entry.data.description}</p></div></li>)}</ol></div></section><section class="section projects" id="projects"><div class="container two"><span class="eyebrow">Selected research & projects</span><div>{projects.length?projects.map(p=><article><h3>{p.data.title}</h3><p>{p.data.description}</p></article>):<><h2>Work will be added when it is ready.</h2><p>This space is prepared for independent, academic and public knowledge projects based on transparent sources and clearly stated methods.</p></>}</div></div></section><section class="section"><div class="container two"><span class="eyebrow">Tools & frameworks</span><div class="terms">{tools.map(x=><span>{x}</span>)}</div></div></section><section class="section connect"><div class="container two"><span class="eyebrow">Connect</span><div><h2>Interested in the same questions?</h2><a class="button" href="/contact/">Get in touch</a></div></div></section></BaseLayout>
<style>.two{display:grid;grid-template-columns:1fr 2fr;gap:6vw}.two h2{margin-bottom:20px}.profile .prose{font-size:1.3rem}.background,.education,.projects{background:var(--paper-2)}.lead,.background p,.projects p{max-width:62ch;color:var(--muted)}.terms{display:grid;grid-template-columns:1fr 1fr;margin-top:30px}.terms span{padding:13px 0;border-top:1px solid var(--line)}.research{list-style:none;padding:0;margin:0}.research li{display:grid;grid-template-columns:44px 1fr;padding:16px 0;border-top:1px solid var(--line)}.research li>span{font-size:.7rem;color:var(--muted)}.research p{font-size:.86rem;color:var(--muted);margin:4px 0}.projects article{border-top:1px solid var(--line);padding:18px 0}.connect h2{margin-bottom:28px}@media(max-width:700px){.two{grid-template-columns:1fr}.terms{grid-template-columns:1fr}}</style>
