---
import { getCollection, render } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('library',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;
---
<BaseLayout title={entry.data.title} description={entry.data.summary} type="article"><article><header class="page-intro reading"><div class="eyebrow">{entry.data.entryType} · {entry.data.area}</div><h1>{entry.data.title}</h1><p>{entry.data.summary}</p>{entry.data.organisation&&<div class="meta">{entry.data.organisation}</div>}</header><div class="reading prose"><Content /></div></article><div class="reading back"><a class="text-link" href={`${base}library/`}>← Methods & Resources Library</a></div></BaseLayout>
<style>article{padding-bottom:70px}.page-intro h1{max-width:13ch;font-size:clamp(3rem,7vw,6rem)}.back{padding:20px 0 100px;border-top:1px solid var(--line)}</style>
