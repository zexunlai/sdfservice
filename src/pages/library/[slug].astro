---
import BaseLayout from '../../layouts/BaseLayout.astro';import GlossaryContent from '../../components/GlossaryContent.astro';import {getEntry,render} from 'astro:content';import {getAnalyses,getHubBySlug,getResourceBySlug,getPublicGlossaryDefinitions} from '../../lib/platform-data';
export const prerender=false;const slug=Astro.params.slug!;const [hub,resource,analyses]=await Promise.all([getHubBySlug(Astro.locals,slug),getResourceBySlug(Astro.locals,slug),getAnalyses(Astro.locals,'en')]);const analysis=(analyses as any[]).find(x=>x.slug===slug);const definitions=analysis?await getPublicGlossaryDefinitions(Astro.locals,analysis.contentLocale):[];let legacy:any=null,LegacyContent:any=null;if(!hub&&!resource&&!analysis){legacy=await getEntry('library',slug);if(legacy)({Content:LegacyContent}=await render(legacy));}if(!hub&&!resource&&!analysis&&!legacy)Astro.response.status=404;const title=hub?.title??resource?.official_title??analysis?.title??legacy?.data.title??'Not found';const description=hub?.description??resource?.description??analysis?.summary??legacy?.data.summary??'';const canonical=new URL(Astro.url.pathname,Astro.site).toString();const schema={'@context':'https://schema.org','@type':resource?.resource_types?.name==='Dataset'?'Dataset':analysis?'TechArticle':'WebPage',name:title,headline:title,description,url:canonical};
---
<BaseLayout title={title} description={description} schema={schema}>
{hub&&<><header class="page-intro container"><span class="eyebrow">Official resource hub</span><h1>{hub.title}</h1><p>{hub.description}</p><div class="meta"><span>{hub.organisations.name}</span>{hub.last_verified_at&&<span>Last verified {hub.last_verified_at.slice(0,10)}</span>}</div><a class="text-link" href={hub.official_website||hub.organisations.official_website} rel="noreferrer">Official website ↗</a></header><section class="section"><div class="container"><div class="resource-sections">{[...new Set((hub.official_resources??[]).filter((x:any)=>x.published&&x.status==='current').map((x:any)=>x.resource_types.name))].map((group:any)=><section><h2>{group}</h2>{(hub.official_resources??[]).filter((r:any)=>r.published&&r.status==='current'&&r.resource_types.name===group).map((r:any)=><article><div><span>{r.year??'Current'}</span><span>{r.format}</span><span>{String(r.access).replaceAll('_',' ')}</span></div><h3><a href={`/library/${r.slug}/`}>{r.official_title}</a></h3><p>{r.description}</p></article>)}</section>)}</div>{!(hub.official_resources??[]).length&&<p>No verified resources published yet.</p>}</div></section></>}
{resource&&<><header class="page-intro container"><span class="eyebrow">{resource.organisations.name} · {resource.resource_types.name}</span><h1>{resource.official_title}</h1><p>{resource.description}</p><div class="badges"><span>Official source</span><span>{resource.status}</span>{resource.access==='paid'&&<span>Full standard not public</span>}</div></header><section class="container facts"><div><span>Organisation</span><strong><a href={`/library/${resource.resource_hubs.slug}/`}>{resource.organisations.name}</a></strong></div><div><span>Format</span><strong>{resource.format}</strong></div><div><span>Year / version</span><strong>{[resource.year,resource.version_label].filter(Boolean).join(' · ')||'Current'}</strong></div><div><span>Last verified</span><strong>{resource.last_verified_at?.slice(0,10)??'Not recorded'}</strong></div></section><section class="section"><div class="container detail"><div><span class="eyebrow">Areas</span>{resource.resource_areas?.map((x:any)=><p>{x.expertise_areas.display_name}</p>)}</div><div><span class="eyebrow">Access</span><p>{String(resource.access).replaceAll('_',' ')}</p></div><div><span class="eyebrow">Source</span><a class="button" href={resource.official_url} rel="noreferrer">Open official source</a></div></div></section>{resource.data_theme&&<section class="section"><div class="container"><span class="eyebrow">Geospatial data</span><dl class="gis">{[['Data theme',resource.data_theme],['Data type',resource.data_type],['Platform or sensor',resource.platform_or_sensor],['Spatial resolution',resource.spatial_resolution],['Temporal resolution',resource.temporal_resolution],['Temporal coverage',resource.temporal_coverage],['Geographic coverage',resource.geographic_coverage],['Processing level',resource.processing_level],['Data format',resource.data_format],['License',resource.license]].filter(([,v])=>v).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div></section>}</>}
{analysis&&<article><header class="page-intro reading"><span class="eyebrow">My analysis · {analysis.area}</span><h1>{analysis.title}</h1><p>{analysis.summary}</p></header><div class="reading prose"><GlossaryContent html={analysis.bodyHtml} definitions={definitions}/></div></article>}
{legacy&&<><header class="page-intro reading"><span class="eyebrow">My analysis · {legacy.data.area}</span><h1>{legacy.data.title}</h1><p>{legacy.data.summary}</p></header><section class="reading prose"><LegacyContent/></section></>}
{!hub&&!resource&&!analysis&&!legacy&&<header class="page-intro container"><h1>Not found</h1></header>}
</BaseLayout>
<style>.facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--ink);padding-bottom:70px}.facts div{padding:14px;border-right:1px solid var(--line)}.facts span,.facts strong{display:block}.facts span{font-size:.7rem;text-transform:uppercase;color:var(--muted)}.detail{display:grid;grid-template-columns:1fr 1fr 1fr;gap:40px}.badges{display:flex;gap:8px}.badges span{border:1px solid var(--line);padding:4px 8px;font-size:.7rem;text-transform:uppercase}.resource-sections>section{margin-bottom:55px}.resource-sections h2{font-size:2rem;border-bottom:1px solid var(--ink);padding-bottom:12px}.resource-sections article{padding:20px 0;border-bottom:1px solid var(--line)}.resource-sections article>div{display:flex;gap:10px;font-size:.72rem;color:var(--muted)}.resource-sections h3{margin:8px 0}.resource-sections h3 a{text-decoration:none}.gis{display:grid;grid-template-columns:repeat(3,1fr)}.gis div{padding:14px;border-top:1px solid var(--line)}.gis dt{font-size:.7rem;text-transform:uppercase;color:var(--muted)}.gis dd{margin:6px 0 0}@media(max-width:700px){.facts,.detail,.gis{grid-template-columns:1fr}.facts div{border-bottom:1px solid var(--line)}}</style>
