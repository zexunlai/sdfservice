---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('library',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id},props:{entry}}))} const {entry}=Astro.props; const {Content}=await render(entry); const d=entry.data; const carbon=[['Baseline',d.baseline],['Additionality',d.additionality],['MRV',d.mrv],['Leakage',d.leakage],['Permanence',d.permanence],['Crediting period',d.creditingPeriod],['Validation',d.validation],['Verification',d.verification]].filter(([,value])=>value); const canonical=new URL(Astro.url.pathname,Astro.site).toString(); const schema={'@context':'https://schema.org','@graph':[{'@type':'TechArticle',headline:d.title,description:d.summary,url:canonical},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site).toString()},{'@type':'ListItem',position:2,name:'Methodology Library',item:new URL('/library/',Astro.site).toString()},{'@type':'ListItem',position:3,name:d.title,item:canonical}]}]};
---
<BaseLayout title={d.title} description={d.summary} schema={schema}><header class="page-intro container"><span class="eyebrow">{d.area} · {d.entryType}</span><h1>{d.title}</h1><p>{d.summary}</p></header><section class="container facts"><div><span>Organisation</span><strong>{d.organisation||'Independent analytical method'}</strong></div>{d.version&&<div><span>Version</span><strong>{d.version}</strong></div>}<div><span>Last reviewed</span><strong>{d.lastReviewed.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</strong></div>{d.officialSource&&<div><span>Official source</span><strong><a href={d.officialSource} rel="noreferrer">View source ↗</a></strong></div>}</section><section class="section"><div class="container detail"><div><span class="eyebrow">Applicability</span><p>{d.applicability}</p></div><div><span class="eyebrow">Key concepts</span><ul>{d.keyConcepts.map(x=><li>{x}</li>)}</ul></div><div><span class="eyebrow">Key requirements</span><ul>{d.keyRequirements.map(x=><li>{x}</li>)}</ul></div></div></section>{carbon.length>0&&<section class="section carbon"><div class="container"><span class="eyebrow">Carbon-specific considerations</span><div>{carbon.map(([label,value])=><article><h3>{label}</h3><p>{value}</p></article>)}</div></div></section>}<section class="section"><div class="reading prose"><Content/></div></section></BaseLayout>
<style>.facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--ink);padding-bottom:70px}.facts div{padding:14px;border-right:1px solid var(--line)}.facts span,.facts strong{display:block}.facts span{font-size:.7rem;text-transform:uppercase;color:var(--muted)}.facts strong{font-size:.85rem;margin-top:8px}.detail{display:grid;grid-template-columns:1fr 1fr 1fr;gap:40px}.detail p{margin-top:20px;color:var(--muted)}.detail ul{list-style:none;padding:0;margin-top:20px}.detail li{padding:10px 0;border-top:1px solid var(--line)}.carbon{background:var(--paper-2)}.carbon .container{display:grid;grid-template-columns:1fr 2fr;gap:50px}.carbon article{padding:18px 0;border-top:1px solid var(--line)}.carbon p{color:var(--muted)}@media(max-width:700px){.facts,.detail,.carbon .container{grid-template-columns:1fr}.facts div{border-bottom:1px solid var(--line)}}</style>
