---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base=`${import.meta.env.BASE_URL}/`;
const entries=(await getCollection('library',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Methods & Resources Library" description="A curated professional reference system of original analyses and verified public environmental resources.">
  <header class="page-intro container"><span class="eyebrow">Library</span><h1>Methods & Resources Library</h1><p>A curated reference system connecting original analysis with methods, frameworks, standards, datasets and technical resources across environmental practice.</p></header>
  <section class="library-shell container"><div class="library-grid"><aside><span class="eyebrow">Reference system</span><p>Each entry is now published directly from this repository. No database or account is required to read it.</p><a class="text-link" href={`${base}publications/`}>Browse publications →</a></aside><main><section><div class="result-head"><h2>Methods & analyses</h2><span>{entries.length}</span></div>{entries.map(entry=><article class="result"><div><span class="badge">{entry.data.entryType}</span><span>{entry.data.area}</span>{entry.data.organisation&&<span>{entry.data.organisation}</span>}</div><h3><a href={`${base}library/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><a class="text-link" href={`${base}library/${entry.id}/`}>View details →</a></article>)}{!entries.length&&<p class="empty">No library entries are published yet.</p>}</section></main></div></section>
</BaseLayout>
<style>.library-shell{padding-bottom:100px}.library-grid{display:grid;grid-template-columns:240px 1fr;gap:50px;padding-top:40px;border-top:1px solid var(--ink)}aside p{color:var(--muted);font-size:.9rem}.result-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:12px}.result-head h2{font-size:2rem}.result{padding:25px 0;border-bottom:1px solid var(--line)}.result>div:first-child{display:flex;gap:10px;flex-wrap:wrap;font-size:.72rem;text-transform:uppercase;color:var(--muted)}.badge{color:var(--accent);font-weight:700}.result h3{font-size:clamp(1.5rem,3vw,2.35rem);margin:13px 0}.result h3 a{text-decoration:none}.result p{color:var(--muted);max-width:68ch}.empty{color:var(--muted);padding:22px 0}@media(max-width:760px){.library-grid{grid-template-columns:1fr;gap:25px}}</style>
