---
import BaseLayout from '../../layouts/BaseLayout.astro';import {expertise} from '../../config/expertise';import {getAnalyses,searchResources} from '../../lib/platform-data';
export const prerender=false;const u=Astro.url.searchParams;const filters={q:u.get('q')??'',area:u.get('area')??'',type:u.get('type')??'',organisation:u.get('organisation')??'',format:u.get('format')??'',language:u.get('language')??'',access:u.get('access')??'',year:u.get('year')??'',page:Number(u.get('page')??1),pageSize:20};const tab=u.get('tab')??'all';const [{resources,count,configured},analyses]=await Promise.all([searchResources(Astro.locals,filters),getAnalyses(Astro.locals,'en')]);const types=['standard','framework','methodology','guidance','analytical-method','questionnaire','scoring-methodology','regulation','tool','dataset','data-portal','api','template','report','webinar'];const formats=['Web','PDF','XLSX','CSV','Dataset','API','Interactive Tool','Interactive Map','Video','Slides'];
---
<BaseLayout title="Methods & Resources Library" description="A curated professional reference system of original analyses and verified official environmental resources."><header class="page-intro container"><span class="eyebrow">Library</span><h1>Methods & Resources Library</h1><p>A curated reference system connecting original analysis with official methods, frameworks, standards, datasets and technical resources across environmental practice.</p></header><section class="library-shell container"><form class="search" method="get" role="search"><label for="library-search">Search the Library</label><div><input id="library-search" name="q" value={filters.q} placeholder="Search IFRS S2, TNFD LEAP, NASA GEDI, VM0042…"><button>Search</button></div></form><nav class="tabs" aria-label="Library mode"><a href="/library/" aria-current={tab==='all'?'page':undefined}>All</a><a href="/library/?tab=analyses" aria-current={tab==='analyses'?'page':undefined}>My Analyses</a><a href="/library/?tab=resources" aria-current={tab==='resources'?'page':undefined}>Official Resources</a></nav><div class="library-grid"><aside><details open><summary>Filters</summary><form method="get" class="filter-form"><input type="hidden" name="q" value={filters.q}><input type="hidden" name="tab" value={tab}><label>Area<select name="area"><option value="">All areas</option>{expertise.map(x=><option value={x.slug} selected={filters.area===x.slug}>{x.title}</option>)}</select></label><label>Resource type<select name="type"><option value="">All types</option>{types.map(x=><option value={x} selected={filters.type===x}>{x.replaceAll('-',' ')}</option>)}</select></label><label>Format<select name="format"><option value="">All formats</option>{formats.map(x=><option selected={filters.format===x}>{x}</option>)}</select></label><label>Language<input name="language" value={filters.language} placeholder="en"></label><label>Access<select name="access"><option value="">All access</option>{['public','free_registration','subscription','paid','reference_only'].map(x=><option selected={filters.access===x}>{x.replaceAll('_',' ')}</option>)}</select></label><label>Year<input type="number" name="year" value={filters.year}></label><button>Apply</button><a href="/library/">Clear filters</a></form></details></aside><main>{!configured&&<p class="source-note">The database connection is not configured in this environment. Existing Markdown content remains preserved for migration.</p>}{tab!=='resources'&&<section><div class="result-head"><h2>My Analyses</h2><span>{analyses.length}</span></div>{analyses.map((x:any)=><article class="result"><div><span class="badge">My analysis</span><span>{x.area}</span></div><h3><a href={`/library/${x.slug}/`}>{x.title}</a></h3><p>{x.summary}</p><a class="text-link" href={`/library/${x.slug}/`}>View analysis →</a></article>)}{!analyses.length&&<p class="empty">No published analyses yet.</p>}</section>}{tab!=='analyses'&&<section><div class="result-head"><h2>Official Resources</h2><span>{count}</span></div>{resources.map((r:any)=><article class="result"><div><span class="badge">Official source</span><span>{r.organisations.name}</span><span>{r.resource_types.name}</span>{r.year&&<span>{r.year}</span>}</div><h3><a href={`/library/${r.slug}/`}>{r.official_title}</a></h3><p>{r.description}</p><dl><div><dt>Format</dt><dd>{r.format}</dd></div><div><dt>Access</dt><dd>{String(r.access).replaceAll('_',' ')}</dd></div><div><dt>Status</dt><dd>{r.status}</dd></div><div><dt>Last verified</dt><dd>{r.last_verified_at?.slice(0,10)??'Not recorded'}</dd></div></dl><div class="actions"><a class="text-link" href={`/library/${r.slug}/`}>View details →</a><a class="text-link" href={r.official_url} rel="noreferrer">Open official source ↗</a></div></article>)}{!resources.length&&<p class="empty">No verified resources published yet.</p>}</section>}</main></div></section></BaseLayout>
<style>.library-shell{padding-bottom:100px}.search{border-top:1px solid var(--ink);padding:24px 0}.search>label{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}.search>div{display:flex}.search input{flex:1;padding:15px;border:1px solid var(--line);font:inherit;background:white}.search button,.filter-form button{background:var(--forest);color:white;border:0;padding:10px 20px}.tabs{display:flex;gap:24px;border-block:1px solid var(--line);padding:15px 0}.tabs a{text-decoration:none}.tabs a[aria-current=page]{font-weight:600;color:var(--forest)}.library-grid{display:grid;grid-template-columns:240px 1fr;gap:50px;padding-top:40px}.filter-form{display:grid;gap:14px}.filter-form label{display:grid;gap:4px;font-size:.72rem;text-transform:uppercase}.filter-form input,.filter-form select{min-width:0;padding:8px;border:1px solid var(--line);background:white}.filter-form>a{text-align:center}.result-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:12px}.result-head h2{font-size:2rem}.result{padding:25px 0;border-bottom:1px solid var(--line)}.result>div:first-child{display:flex;gap:10px;flex-wrap:wrap;font-size:.72rem;text-transform:uppercase;color:var(--muted)}.badge{color:var(--forest);font-weight:600}.result h3{font-size:clamp(1.5rem,3vw,2.35rem);margin:13px 0}.result h3 a{text-decoration:none}.result p{color:var(--muted);max-width:68ch}.result dl{display:flex;gap:24px;flex-wrap:wrap}.result dl div{display:grid}.result dt{font-size:.65rem;text-transform:uppercase;color:var(--muted)}.result dd{margin:0;font-size:.78rem}.result .actions{display:flex;gap:20px;margin-top:17px}.empty,.source-note{color:var(--muted);padding:22px 0}.source-note{border-left:2px solid var(--sand);padding-left:15px}@media(max-width:760px){.library-grid{grid-template-columns:1fr;gap:25px}.library-grid aside details:not([open]) .filter-form{display:none}.search>div{display:grid}.tabs{overflow-x:auto}.result .actions{display:grid}}</style>
