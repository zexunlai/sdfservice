---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import resources from '../../data/external-resources.json';
const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;
const analyses=(await getCollection('library',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Methods & Resources Library" description="Methodology analyses and verified external environmental resources."><header class="page-intro container"><span class="eyebrow">Library</span><h1>Methods & Resources Library</h1><p>A two-layer reference system: original methodology analyses and verified external official sources.</p></header><section class="library-shell container"><div class="library-controls"><label><span>Search the Library</span><input id="library-search" type="search" placeholder="Search methods and official sources"></label><nav class="tabs" aria-label="Library layer"><button class="tab active" data-tab="all">All</button><button class="tab" data-tab="analyses">My methodology analyses</button><button class="tab" data-tab="resources">External official resources</button></nav></div><div class="library-grid"><aside><span class="eyebrow">Two layers</span><p><strong>My methodology analyses</strong> are original writing and interpretation. <strong>External official resources</strong> link to the originating organisations and are kept separate.</p><div class="resource-filters"><label>Format<select id="format-filter"><option value="">All formats</option>{[...new Set(resources.map(item=>item.format).filter(Boolean))].sort().map(format=><option value={format}>{format}</option>)}</select></label><label>Access<select id="access-filter"><option value="">All access</option>{[...new Set(resources.map(item=>item.access).filter(Boolean))].sort().map(access=><option value={access}>{access.replaceAll('_',' ')}</option>)}</select></label></div></aside><main><section data-layer="analyses"><div class="result-head"><h2>My methodology analyses</h2><span>{analyses.length}</span></div>{analyses.map(entry=><article class="result analysis" data-search={`${entry.data.title} ${entry.data.summary} ${entry.data.area}`.toLowerCase()}><div><span class="badge">My analysis</span><span>{entry.data.area}</span><span>{entry.data.entryType}</span></div><h3><a href={`${base}library/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><a class="text-link" href={`${base}library/${entry.id}/`}>View analysis →</a></article>)}{!analyses.length&&<p class="empty">No methodology analyses have been published yet.</p>}</section><section data-layer="resources"><div class="result-head"><h2>External official resources</h2><span>{resources.length}</span></div>{resources.map(resource=><article class="result resource" data-search={`${resource.title} ${resource.description} ${resource.format ?? ''} ${resource.language ?? ''}`.toLowerCase()} data-format={resource.format ?? ''} data-access={resource.access ?? ''}><div><span class="badge">Official source</span>{resource.format&&<span>{resource.format}</span>}{resource.year&&<span>{resource.year}</span>}{resource.language&&<span>{resource.language}</span>}</div><h3><a href={resource.url} target="_blank" rel="noreferrer">{resource.title}</a></h3><p>{resource.description}</p><div class="actions"><span>{resource.access?.replaceAll('_',' ')}</span>{resource.lastVerified&&<span>Verified {resource.lastVerified}</span>}<a class="text-link" href={resource.url} target="_blank" rel="noreferrer">Open official source ↗</a></div></article>)}</section><p class="empty" id="library-empty" hidden>No library entries match this filter.</p></main></div></section></BaseLayout>
<script is:inline>const tabs=[...document.querySelectorAll('.tab')],sections=[...document.querySelectorAll('[data-layer]')],search=document.querySelector('#library-search'),format=document.querySelector('#format-filter'),access=document.querySelector('#access-filter'),analyses=[...document.querySelectorAll('.analysis')],resources=[...document.querySelectorAll('.resource')],empty=document.querySelector('#library-empty');let layer='all';function apply(){const term=search.value.trim().toLowerCase(),selectedFormat=format.value,selectedAccess=access.value;let shown=0;analyses.forEach(item=>{const visible=(layer==='all'||layer==='analyses')&&item.dataset.search.includes(term);item.hidden=!visible;if(visible)shown++});resources.forEach(item=>{const visible=(layer==='all'||layer==='resources')&&item.dataset.search.includes(term)&&(!selectedFormat||item.dataset.format===selectedFormat)&&(!selectedAccess||item.dataset.access===selectedAccess);item.hidden=!visible;if(visible)shown++});sections.forEach(section=>section.hidden=layer!=='all'&&section.dataset.layer!==layer);empty.hidden=shown!==0}tabs.forEach(tab=>tab.addEventListener('click',()=>{layer=tab.dataset.tab;tabs.forEach(item=>item.classList.toggle('active',item===tab));apply()}));[search,format,access].forEach(item=>{item?.addEventListener('input',apply);item?.addEventListener('change',apply)});</script>
<style>.library-shell{padding-bottom:100px}.library-controls{border-top:1px solid var(--ink);padding:24px 0}.library-controls label{display:grid;gap:7px}.library-controls label span,.resource-filters label{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.library-controls input{padding:15px;border:1px solid var(--line);font:inherit;background:white}.tabs{display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:18px 0 0;margin-top:18px}.tab{border:0;border-bottom:2px solid transparent;background:transparent;padding:10px 0;font:inherit;cursor:pointer}.tab+.tab{margin-left:18px}.tab.active{border-color:var(--forest);color:var(--forest);font-weight:600}.library-grid{display:grid;grid-template-columns:240px 1fr;gap:50px;padding-top:40px}.library-grid aside p{color:var(--muted);font-size:.88rem}.resource-filters{display:grid;gap:14px;margin-top:25px}.resource-filters label{display:grid;gap:5px}.resource-filters select{padding:8px;border:1px solid var(--line);background:white;font:inherit}.result-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:12px;margin-top:0}.result-head h2{font-size:2rem}.result{padding:25px 0;border-bottom:1px solid var(--line)}.result>div:first-child,.actions{display:flex;gap:10px;flex-wrap:wrap;font-size:.72rem;text-transform:uppercase;color:var(--muted)}.badge{color:var(--forest);font-weight:600}.result h3{font-size:clamp(1.5rem,3vw,2.35rem);margin:13px 0}.result h3 a{text-decoration:none}.result p{color:var(--muted);max-width:68ch}.actions{margin-top:17px}.actions .text-link{margin-left:auto}.empty{color:var(--muted);padding:22px 0}@media(max-width:760px){.library-grid{grid-template-columns:1fr;gap:25px}.tabs{overflow-x:auto}.tab+.tab{margin-left:8px}}</style>
