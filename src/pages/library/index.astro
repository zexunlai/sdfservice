---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content'; import {expertise} from '../../config/expertise'; const entries=await getCollection('library',({data})=>!data.draft); const areas=['All',...expertise.map(x=>x.title)]; const types=['All','Methodology','Framework','Standard','Analytical Method','Guidance','Tool'];
---
<BaseLayout title="Methodology Library" description="A structured knowledge library of methods, frameworks, standards and analytical approaches."><header class="page-intro container"><span class="eyebrow">Library</span><h1>Methodology Library</h1><p>A structured knowledge library of methods, frameworks, standards and analytical approaches used across environmental analysis and decision-making.</p></header><section class="section"><div class="container"><div class="filter-block"><span>Area</span><div role="group" aria-label="Filter library by area">{areas.map((item,i)=><button data-area={item} aria-pressed={i===0?'true':'false'}>{item}</button>)}</div></div><div class="filter-block"><span>Entry type</span><div role="group" aria-label="Filter library by entry type">{types.map((item,i)=><button data-type={item} aria-pressed={i===0?'true':'false'}>{item}</button>)}</div></div><div class="entries">{entries.map(({id,data})=><article data-entry-area={data.area} data-entry-type={data.entryType}><div class="meta"><span>{data.area}</span><span>{data.entryType}</span></div><h2><a href={`/library/${id}/`}>{data.title}</a></h2><p>{data.summary}</p><a class="text-link" href={`/library/${id}/`}>View entry →</a></article>)}</div><p id="empty" hidden>No published entries match these filters.</p></div></section><script>let area='All',type='All';const entries=[...document.querySelectorAll<HTMLElement>('.entries article')];const empty=document.querySelector<HTMLElement>('#empty');function update(){let count=0;entries.forEach(e=>{const show=(area==='All'||e.dataset.entryArea===area)&&(type==='All'||e.dataset.entryType===type);e.hidden=!show;if(show)count++});if(empty)empty.hidden=count>0}document.querySelectorAll<HTMLButtonElement>('[data-area]').forEach(b=>b.addEventListener('click',()=>{area=b.dataset.area??'All';document.querySelectorAll('[data-area]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));update()}));document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach(b=>b.addEventListener('click',()=>{type=b.dataset.type??'All';document.querySelectorAll('[data-type]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));update()}));</script></BaseLayout>
<style>.filter-block{display:grid;grid-template-columns:120px 1fr;gap:25px;padding:13px 0;border-top:1px solid var(--line)}.filter-block>span{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em}.filter-block button{border:0;background:transparent;padding:4px 9px;color:var(--muted);font:inherit;font-size:.78rem;cursor:pointer}.filter-block button[aria-pressed=true]{color:var(--ink);text-decoration:underline;text-underline-offset:5px}.entries{margin-top:60px}.entries article{display:grid;grid-template-columns:1fr 2fr 2fr 120px;gap:28px;padding:28px 0;border-top:1px solid var(--line)}.entries h2{font-size:clamp(1.5rem,3vw,2.4rem)}.entries h2 a{text-decoration:none}.entries p{color:var(--muted)}#empty{padding:50px 0;color:var(--muted)}@media(max-width:760px){.filter-block,.entries article{grid-template-columns:1fr}.filter-block div{display:flex;gap:6px;flex-wrap:wrap}.entries article{gap:10px}.entries .meta{margin-bottom:5px}}</style>
