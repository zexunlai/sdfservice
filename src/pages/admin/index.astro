---
import AdminLayout from '../../layouts/AdminLayout.astro';import{getAdminContext}from'../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);const c={articles:0,analyses:0,resources:0,healthy:0,reviewDue:0,broken:0,blocked:0,machine:0,outdated:0,unpublished:0,glossary:0};let activity:any[]=[],favorites:any[]=[];if(client){const[a,n,r,h,t,g,u,f]=await Promise.all([client.from('articles').select('status'),client.from('library_analyses').select('status'),client.from('official_resources').select('status'),client.from('official_resources').select('health,next_review_at'),client.from('article_translations').select('translation_status,is_published'),client.from('glossary_terms').select('status'),client.from('audit_log').select('action,entity_type,created_at').order('created_at',{ascending:false}).limit(8),client.from('admin_favorites').select('label,entity_type,entity_id').order('sort_order').limit(12)]);c.articles=(a.data??[]).filter(x=>x.status==='published').length;c.analyses=(n.data??[]).filter(x=>x.status==='published').length;c.resources=(r.data??[]).filter(x=>x.status==='current').length;for(const x of h.data??[]){if(x.health==='healthy')c.healthy++;if(x.health==='broken')c.broken++;if(x.health==='blocked')c.blocked++;if(x.next_review_at&&new Date(x.next_review_at)<new Date())c.reviewDue++}for(const x of t.data??[]){if(x.translation_status==='machine_translated')c.machine++;if(x.translation_status==='outdated')c.outdated++;if(!x.is_published)c.unpublished++}c.glossary=(g.data??[]).filter(x=>x.status==='approved').length;activity=u.data??[];favorites=f.data??[]}
---
<AdminLayout title="Dashboard"><div class="page-head"><div><h1>Dashboard</h1><p>Content, translation, resource integrity and recent work in one place.</p></div></div><div class="stats"><div class="stat"><strong>{c.articles}</strong><span>Published articles</span></div><div class="stat"><strong>{c.analyses}</strong><span>Published analyses</span></div><div class="stat"><strong>{c.resources}</strong><span>Current resources</span></div><div class="stat"><strong>{c.reviewDue}</strong><span>Review due</span></div></div><div class="admin-grid"><section class="panel"><h2>Quick actions</h2><div class="actions"><a class="admin-button primary" href="/admin/articles/?new=1">+ New article</a><a class="admin-button" href="/admin/analyses/?new=1">+ New analysis</a><a class="admin-button" href="/admin/library/?new=1">+ New official resource</a><a class="admin-button" href="/admin/organisations/?new=1">+ New organisation</a><a class="admin-button" href="/admin/glossary/?new=1">+ New glossary term</a></div></section><section class="panel"><h2>Translation status</h2><div class="stats" style="grid-template-columns:repeat(4,1fr);margin:0"><div><strong>{c.machine}</strong><small>Machine</small></div><div><strong>{c.outdated}</strong><small>Outdated</small></div><div><strong>{c.unpublished}</strong><small>Unpublished</small></div><div><strong>{c.glossary}</strong><small>Terms</small></div></div></section><section class="panel"><h2>Resource health</h2><div class="stats" style="grid-template-columns:repeat(4,1fr);margin:0"><div><strong>{c.healthy}</strong><small>Healthy</small></div><div><strong>{c.reviewDue}</strong><small>Due</small></div><div><strong>{c.broken}</strong><small>Broken</small></div><div><strong>{c.blocked}</strong><small>Blocked</small></div></div></section><section class="panel"><h2>Quick access</h2>{favorites.length?favorites.map(f=><p><a href={`/admin/library/?id=${f.entity_id}`}>{f.label??f.entity_type}</a></p>):<p class="empty">Pin official resources to access them here across devices.</p>}</section><section class="panel"><h2>Recent admin activity</h2>{activity.length?activity.map(a=><p><strong>{a.action}</strong> · {a.entity_type}<br><small>{new Date(a.created_at).toLocaleString('en-GB')}</small></p>):<p class="empty">No activity recorded yet.</p>}</section></div></AdminLayout>
