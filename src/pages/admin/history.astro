---
import AdminLayout from '../../layouts/AdminLayout.astro';import{getAdminContext}from'../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);const{data}=await client.from('content_revisions').select('*,admin_users(email)').order('changed_at',{ascending:false}).limit(100);
---
<AdminLayout title="Revision History"><div class="page-head"><div><h1>Revision History</h1><p>Restore a captured version of articles, analyses, website copy, glossary terms and official resources.</p></div></div><div class="table-wrap"><table class="data-list"><thead><tr><th>Changed</th><th>Entity</th><th>By</th><th>Snapshot</th><th></th></tr></thead><tbody>{(data??[]).map(r=><tr><td>{new Date(r.changed_at).toLocaleString('en-GB')}</td><td><strong>{r.entity_type}</strong><br><small>{r.entity_id}</small></td><td>{r.admin_users?.email??'System'}</td><td><details><summary>View previous data</summary><pre style="white-space:pre-wrap;max-width:600px">{JSON.stringify(r.previous_data,null,2)}</pre></details></td><td><form action="/api/admin/restore" method="post"><input type="hidden" name="revision_id" value={r.id}><button>Restore</button></form></td></tr>)}</tbody></table></div></AdminLayout>
