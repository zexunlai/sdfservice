---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAdminContext } from '../../../lib/supabase';
export const prerender=false;
const {client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);
const id=Astro.url.searchParams.get('id');const entity=Astro.params.entity;let title='Preview',summary='',body='';
if(id&&entity==='article'){const {data}=await client.from('articles').select('article_translations(locale,title,summary,body_html)').eq('id',id).single();const tr=(data?.article_translations??[]).find((x:any)=>x.locale==='en');title=tr?.title??title;summary=tr?.summary??'';body=tr?.body_html??'';}
if(id&&entity==='analysis'){const {data}=await client.from('library_analyses').select('analysis_translations(locale,title,summary,body_html)').eq('id',id).single();const tr=(data?.analysis_translations??[]).find((x:any)=>x.locale==='en');title=tr?.title??title;summary=tr?.summary??'';body=tr?.body_html??'';}
if(!id||!['article','analysis'].includes(entity??''))Astro.response.status=404;
---
<BaseLayout title={`${title} — Preview`} description={summary}><header class="page-intro reading"><span class="eyebrow">Private owner preview</span><h1>{title}</h1><p>{summary}</p></header><article class="reading prose" set:html={body}/></BaseLayout>
<style>.prose{padding-bottom:100px}</style>
