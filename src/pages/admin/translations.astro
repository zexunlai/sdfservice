---
import AdminLayout from '../../layouts/AdminLayout.astro';import{getAdminContext}from'../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);const [a,b,j,s]=await Promise.all([client.from('article_translations').select('id,article_id,locale,title,translation_status,translation_provider,translator_name,translated_at,reviewed_at,is_published,articles(slug,source_language,updated_at)').order('updated_at',{ascending:false}),client.from('analysis_translations').select('id,analysis_id,locale,title,translation_status,translation_provider,translator_name,translated_at,reviewed_at,is_published,library_analyses(slug,source_language,updated_at)').order('updated_at',{ascending:false}),client.from('translation_jobs').select('*').order('created_at',{ascending:false}).limit(20),client.from('translation_glossary_syncs').select('*').order('created_at',{ascending:false}).limit(4)]);const translations=[...(a.data??[]).map((x:any)=>({...x,kind:'article',parent:x.articles,parentId:x.article_id})),...(b.data??[]).map((x:any)=>({...x,kind:'analysis',parent:x.library_analyses,parentId:x.analysis_id}))];const counts={missing:translations.filter(x=>x.locale!==(x.parent?.source_language??'en')&&!x.is_published).length,machine:translations.filter(x=>x.translation_status==='machine_translated').length,reviewed:translations.filter(x=>['machine_translated_human_reviewed','human_translated'].includes(x.translation_status)).length,outdated:translations.filter(x=>x.translation_status==='outdated').length};
---
<AdminLayout title="Translations"><div class="page-head"><div><h1>Translations</h1><p>Linked language versions, provenance and source-revision freshness.</p></div></div><div class="stats"><div class="stat"><strong>{counts.machine}</strong><span>Machine translated</span></div><div class="stat"><strong>{counts.reviewed}</strong><span>Human reviewed</span></div><div class="stat"><strong>{counts.missing}</strong><span>Not published</span></div><div class="stat"><strong>{counts.outdated}</strong><span>Out of date</span></div></div><section class="panel"><h2>Content translations</h2><div class="table-wrap"><table class="data-list"><thead><tr><th>Content</th><th>Locale</th><th>Status</th><th>Provenance</th><th>Published</th><th></th></tr></thead><tbody>{translations.map(t=><tr><td><strong>{t.title||t.parent?.slug}</strong><br><small>{t.kind}</small></td><td>{t.locale}{t.locale===t.parent?.source_language&&' · original'}</td><td><span class={`status ${t.translation_status}`}>{t.translation_status.replaceAll('_',' ')}</span></td><td>{t.translation_provider??t.translator_name??'Editorial'}</td><td>{t.is_published?'Yes':'No'}</td><td><a class="admin-button" href={`/admin/${t.kind==='article'?'articles':'analyses'}/?id=${t.parentId}`}>Open editor</a></td></tr>)}</tbody></table></div></section><div class="admin-grid"><section class="panel"><h2>Recent translation jobs</h2>{(j.data??[]).map((x:any)=><p><strong>{x.provider}</strong> · {x.source_locale} → {x.target_locale}<br><small>{x.job_status} · {new Date(x.created_at).toLocaleString('en-GB')}</small></p>)}</section><section class="panel"><h2>Provider glossary</h2>{(s.data??[]).length?(s.data??[]).map((x:any)=><p><strong>{x.provider}</strong> · {x.source_locale} → {x.target_locale}<br><small>{x.sync_status} · {x.approved_term_count} terms</small></p>):<p class="empty">No glossary has been synced yet.</p>}<form action="/api/admin/glossary-sync" method="post"><button class="primary">Sync Google glossary</button></form></section></div></AdminLayout>
