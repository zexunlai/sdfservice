---
import AdminLayout from '../../../layouts/AdminLayout.astro';import{getAdminContext}from'../../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);const{data}=await client.from('site_settings').select('value').eq('key','social_links').single();const links=data?.value??{};
---
<AdminLayout title="Social Links"><div class="page-head"><div><h1>Social Links</h1><p>Edit contact details used throughout the public website.</p></div></div><form class="form-section" action="/api/admin/site-settings" method="post"><input type="hidden" name="key" value="social_links"><div class="form-grid"><div class="field"><label>Email</label><input type="email" name="email" value={links.email??''} required></div><div class="field"><label>LinkedIn URL</label><input type="url" name="linkedin" value={links.linkedin??''} required></div><div class="field"><label>Location</label><input name="location" value={links.location??'Taiwan'}></div></div><button class="primary" style="margin-top:18px">Save social links</button></form></AdminLayout>
