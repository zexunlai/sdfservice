---
import AdminLayout from '../../layouts/AdminLayout.astro';import{getAdminContext}from'../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);const{data:terms}=await client.from('glossary_terms').select('canonical_english_term,preferred_chinese_term,avoid_english,avoid_chinese,status,translation_rule').order('canonical_english_term');
---
<AdminLayout title="Terminology QA"><div class="page-head"><div><h1>Terminology QA</h1><p>Detect preferred, avoided and case-sensitive terminology. Changes are suggestions until you approve them.</p></div></div><section class="form-section"><div class="form-grid"><div class="field"><label>Language</label><select id="locale"><option value="en">English</option><option value="zh-TW">中文</option></select></div><div class="field full"><label>Paste content to check</label><textarea id="qa-text" rows="14"></textarea></div></div><button class="primary" id="run-check" type="button">Run terminology check</button><div id="qa-results" aria-live="polite"></div></section><section class="panel"><h2>Approved terminology overview</h2><div class="table-wrap"><table class="data-list"><thead><tr><th>English</th><th>中文</th><th>Rule</th><th>Avoid</th></tr></thead><tbody>{(terms??[]).filter((x:any)=>x.status==='approved').map((x:any)=><tr><td>{x.canonical_english_term}</td><td>{x.preferred_chinese_term??'—'}</td><td>{x.translation_rule.replaceAll('_',' ')}</td><td>{[...x.avoid_english,...x.avoid_chinese].join(', ')||'—'}</td></tr>)}</tbody></table></div></section></AdminLayout><script>document.querySelector('#run-check')?.addEventListener('click',async()=>{const output=document.querySelector<HTMLElement>('#qa-results')!,html=(document.querySelector<HTMLTextAreaElement>('#qa-text')!).value,locale=(document.querySelector<HTMLSelectElement>('#locale')!).value;output.textContent='Checking…';const r=await fetch('/api/admin/terminology-check',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({html,locale})});const d=await r.json();output.innerHTML='';const h=document.createElement('h3');h.textContent=`${d.issues?.length??0} terminology issues`;output.append(h);for(const issue of d.issues??[]){const p=document.createElement('p');p.className='notice';p.textContent=`${issue.message} (${issue.count})`;output.append(p)}if(d.candidates?.length){const p=document.createElement('p');p.textContent=`Potential new technical terms: ${d.candidates.join(', ')}`;output.append(p)}});</script>
