---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RichEditor from '../../components/admin/RichEditor.astro';
import { getAdminContext } from '../../lib/supabase';
export const prerender=false;
const section=Astro.params.section??''; const id=Astro.url.searchParams.get('id'); const creating=Astro.url.searchParams.has('new');
const {client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals); if(!client)return Astro.redirect('/login/',303);
const titleMap:Record<string,string>={articles:'Articles',analyses:'My Analyses',library:'Official Resources',hubs:'Resource Hubs',organisations:'Organisations','website/homepage':'Homepage','website/header':'Header','website/expertise':'Expertise','website/about':'About','website/contact':'Contact','website/footer':'Footer','website/legal':'Legal','website/seo':'SEO','website/social-links':'Social Links',messages:'Messages','media':'Media Library','system/health':'Resource Health','system/review-due':'Review Due','system/settings':'Settings','system/audit':'Audit Log'}; const title=titleMap[section]??'Admin';
const {data:areas}=await client.from('expertise_areas').select('id,key,display_name,sort_order,description,summary,keywords').order('sort_order');
let rows:any[]=[],record:any=null,translations:any[]=[],types:any[]=[],organisations:any[]=[],hubs:any[]=[],profileItems:any[]=[];
if(section==='articles'){if(id){const r=await client.from('articles').select('*,article_translations(*)').eq('id',id).single();record=r.data;translations=record?.article_translations??[]}else if(!creating){const r=await client.from('articles').select('id,slug,status,publication_date,updated_at,expertise_areas(display_name),article_translations(locale,title)').order('updated_at',{ascending:false});rows=r.data??[];}}
if(section==='analyses'){if(id){const r=await client.from('library_analyses').select('*,analysis_translations(*)').eq('id',id).single();record=r.data;translations=record?.analysis_translations??[]}else if(!creating){const r=await client.from('library_analyses').select('id,slug,status,publication_date,updated_at,expertise_areas(display_name),analysis_translations(locale,title)').order('updated_at',{ascending:false});rows=r.data??[];}}
if(section==='library'){const [ty,org,hub]=await Promise.all([client.from('resource_types').select('*').eq('active',true).order('sort_order'),client.from('organisations').select('id,name,slug').eq('active',true).order('name'),client.from('resource_hubs').select('id,title,slug,organisation_id').order('title')]);types=ty.data??[];organisations=org.data??[];hubs=hub.data??[];if(id){const r=await client.from('official_resources').select('*,resource_areas(area_id),resource_tags(tag_id)').eq('id',id).single();record=r.data}else if(!creating){const r=await client.from('official_resources').select('id,official_title,status,published,health,year,version_label,last_verified_at,organisations(name),resource_types(name)').order('updated_at',{ascending:false}).limit(100);rows=r.data??[];}}
if(section==='hubs'){const org=await client.from('organisations').select('id,name,slug').eq('active',true).order('name');organisations=org.data??[];if(id){const r=await client.from('resource_hubs').select('*,resource_hub_areas(area_id),official_resources(id,status,health,next_review_at)').eq('id',id).single();record=r.data}else if(!creating){const r=await client.from('resource_hubs').select('id,title,slug,status,last_verified_at,organisations(name),official_resources(id)').order('title');rows=r.data??[];}}
if(section==='organisations'){if(id){const r=await client.from('organisations').select('*,organisation_domains(*)').eq('id',id).single();record=r.data}else if(!creating){const r=await client.from('organisations').select('id,name,slug,official_website,active,organisation_domains(domain)').order('name');rows=r.data??[];}}
if(section.startsWith('website/')){const requestedKey=section.split('/')[1];const pageKey=requestedKey==='homepage'?'home':requestedKey;if(pageKey==='expertise'){rows=areas??[]}else{let query=client.from('site_content').select('*').order('page_key').order('section_key').order('locale');query=pageKey==='legal'?query.in('page_key',['privacy','disclaimer']):query.eq('page_key',pageKey);const r=await query;rows=r.data??[];if(pageKey==='about'){const p=await client.from('profile_items').select('*').order('kind').order('sort_order');profileItems=p.data??[];}}}
if(section==='media'){const r=await client.from('media_assets').select('*').order('created_at',{ascending:false});rows=r.data??[];}
if(section==='system/health'||section==='system/review-due'){let q=client.from('official_resources').select('id,official_title,health,http_status,last_http_check_at,last_verified_at,next_review_at,organisations(name)').order('next_review_at',{ascending:true});if(section==='system/review-due')q=q.lte('next_review_at',new Date(Date.now()+30*86400000).toISOString());const r=await q;rows=r.data??[];}
if(section==='system/audit'){const r=await client.from('audit_log').select('*,admin_users(email)').order('created_at',{ascending:false}).limit(100);rows=r.data??[];}
if(section==='system/settings'){const r=await client.from('site_settings').select('*').order('key');rows=r.data??[];}
if(section==='messages'){const r=await client.from('contact_messages').select('*').order('created_at',{ascending:false}).limit(100);rows=r.data??[];}
const en=translations.find(x=>x.locale==='en')??{},zh=translations.find(x=>x.locale==='zh-TW')??{};
const editing=Boolean(id||creating);
const getTitle=(row:any)=>row.article_translations?.find((x:any)=>x.locale==='en')?.title??row.analysis_translations?.find((x:any)=>x.locale==='en')?.title??row.slug;
---
<AdminLayout title={title}>
<div class="page-head"><div><h1>{title}</h1><p>{section==='library'?'Official, verified, versioned primary sources.':section==='analyses'?'Original technical and methodological analysis.':section.startsWith('website/')?'Edit public website copy without changing code.':'Manage the platform.'}</p></div>{['articles','analyses','library','hubs','organisations'].includes(section)&&!editing&&<a class="admin-button primary" href={`/admin/${section}/?new=1`}>+ New {section==='library'?'resource':section.slice(0,-1)}</a>}</div>
{record&&['articles','analyses'].includes(section)&&<p><a class="admin-button" href={`/admin/preview/${section==='articles'?'article':'analysis'}/?id=${record.id}`} target="_blank">Preview ↗</a></p>}

{section==='articles'&&editing&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="article"><input type="hidden" name="id" value={record?.id??''}><section class="form-section"><h2>Publishing</h2><div class="form-grid"><div class="field"><label>Slug</label><input name="slug" value={record?.slug??''} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required></div><div class="field"><label>Area</label><select name="primary_area_id" required>{areas?.map(a=><option value={a.id} selected={record?.primary_area_id===a.id}>{a.display_name}</option>)}</select></div><div class="field"><label>Subtopic</label><input name="subtopic" value={record?.subtopic??''}></div><div class="field"><label>Source language</label><select name="source_language"><option value="en" selected={(record?.source_language??'en')==='en'}>English</option><option value="zh-TW" selected={record?.source_language==='zh-TW'}>中文</option></select></div><div class="field"><label>Status</label><select name="status"><option selected={record?.status==='draft'}>draft</option><option selected={record?.status==='published'}>published</option><option selected={record?.status==='archived'}>archived</option></select></div><div class="field"><label>Publication date</label><input type="date" name="publication_date" value={record?.publication_date??''}></div><div class="field"><label>Updated date</label><input type="date" name="updated_date" value={record?.updated_date??''}></div><div class="field"><label>Author</label><input name="author" value={record?.author??'Ze-Xun Lai'}></div><div class="field"><label>Tags (comma separated)</label><input name="tags" value={(record?.tags??[]).join(', ')}></div><label class="checkbox"><input type="checkbox" name="featured" checked={record?.featured}> Featured</label></div></section><section class="form-section"><h2>English</h2><div class="form-grid"><div class="field full"><label>Title</label><input name="en_title" value={en.title??''}></div><div class="field full"><label>Subtitle</label><input name="en_subtitle" value={en.subtitle??''}></div><div class="field full"><label>Summary</label><textarea name="en_summary">{en.summary??''}</textarea></div><RichEditor name="en_body" value={JSON.stringify(en.body??{})}/><div class="field"><label>SEO title</label><input name="en_seo_title" value={en.seo_title??''}></div><div class="field"><label>SEO description</label><textarea name="en_seo_description">{en.seo_description??''}</textarea></div></div></section><section class="form-section"><h2>中文（留空時顯示英文）</h2><div class="form-grid"><div class="field full"><label>標題</label><input name="zh_title" value={zh.title??''}></div><div class="field full"><label>摘要</label><textarea name="zh_summary">{zh.summary??''}</textarea></div><RichEditor name="zh_body" value={JSON.stringify(zh.body??{})} label="中文內容"/></div></section><div class="form-actions"><button class="primary">Save</button><a class="admin-button" href="/admin/articles/">Cancel</a>{record&&<button type="submit" name="operation" value="duplicate">Duplicate</button>}</div></form>}
{section==='articles'&&record&&<section class="form-section"><h2>Translation workflow</h2><p><strong>中文:</strong> <span class={`status ${zh.translation_status??'missing'}`}>{(zh.translation_status??'missing').replaceAll('_',' ')}</span>{zh.is_published&&' · published'}{zh.translation_provider&&` · ${zh.translation_provider}`}</p>{zh.translation_status==='outdated'&&<p class="notice">The Chinese translation is out of date because the source article changed.</p>}<div class="actions"><form action="/api/admin/translate" method="post"><input type="hidden" name="entity" value="article"><input type="hidden" name="id" value={record.id}><input type="hidden" name="target_locale" value={record.source_language==='zh-TW'?'en':'zh-TW'}><button class="primary">{zh.title?'Regenerate with Google':'Translate with Google'}</button></form>{zh.title&&<form action="/api/admin/translation-status" method="post"><input type="hidden" name="entity" value="article"><input type="hidden" name="id" value={record.id}><input type="hidden" name="locale" value="zh-TW"><label>Translator <input name="translator_name" value={zh.translator_name??''} placeholder="Name or blank for anonymous"></label><label class="checkbox"><input type="checkbox" name="translation_credit_public" checked={zh.translation_credit_public??true}> Public credit</label><button name="operation" value="review">Mark human reviewed</button><button name="operation" value="human">Mark human translated</button><button name="operation" value="publish">Publish translation</button><button name="operation" value="unpublish">Unpublish</button><button name="operation" value="revert">Revert translation</button></form>}</div></section>}

{section==='analyses' &&editing&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="analysis"><input type="hidden" name="id" value={record?.id??''}><section class="form-section"><h2>Analysis</h2><div class="form-grid"><div class="field"><label>Slug</label><input name="slug" value={record?.slug??''} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required></div><div class="field"><label>Area</label><select name="primary_area_id">{areas?.map(a=><option value={a.id} selected={record?.primary_area_id===a.id}>{a.display_name}</option>)}</select></div><div class="field"><label>Source language</label><select name="source_language"><option value="en" selected={(record?.source_language??'en')==='en'}>English</option><option value="zh-TW" selected={record?.source_language==='zh-TW'}>中文</option></select></div><div class="field"><label>Type</label><select name="analysis_type">{['methodology_analysis','framework_analysis','technical_review','comparison','implementation_interpretation','methodological_commentary'].map(x=><option selected={record?.analysis_type===x}>{x.replaceAll('_',' ')}</option>)}</select></div><div class="field"><label>Status</label><select name="status">{['draft','published','archived'].map(x=><option selected={record?.status===x}>{x}</option>)}</select></div><div class="field"><label>Publication date</label><input type="date" name="publication_date" value={record?.publication_date??''}></div><div class="field"><label>Tags</label><input name="tags" value={(record?.tags??[]).join(', ')}></div></div></section><section class="form-section"><h2>English</h2><div class="form-grid"><div class="field full"><label>Title</label><input name="en_title" value={en.title??''}></div><div class="field full"><label>Summary</label><textarea name="en_summary">{en.summary??''}</textarea></div><RichEditor name="en_body" value={JSON.stringify(en.body??{})}/></div></section><section class="form-section"><h2>中文（optional）</h2><div class="form-grid"><div class="field full"><label>標題</label><input name="zh_title" value={zh.title??''}></div><div class="field full"><label>摘要</label><textarea name="zh_summary">{zh.summary??''}</textarea></div><RichEditor name="zh_body" value={JSON.stringify(zh.body??{})} label="中文內容"/></div></section><div class="form-actions"><button class="primary">Save</button><a class="admin-button" href="/admin/analyses/">Cancel</a>{record&&<button name="operation" value="duplicate">Duplicate</button>}</div></form>}
{section==='analyses'&&record&&<section class="form-section"><h2>Translation workflow</h2><p><strong>中文:</strong> <span class={`status ${zh.translation_status??'missing'}`}>{(zh.translation_status??'missing').replaceAll('_',' ')}</span>{zh.is_published&&' · published'}</p>{zh.translation_status==='outdated'&&<p class="notice">This translation is out of date.</p>}<div class="actions"><form action="/api/admin/translate" method="post"><input type="hidden" name="entity" value="analysis"><input type="hidden" name="id" value={record.id}><input type="hidden" name="target_locale" value={record.source_language==='zh-TW'?'en':'zh-TW'}><button class="primary">{zh.title?'Regenerate with Google':'Translate with Google'}</button></form>{zh.title&&<form action="/api/admin/translation-status" method="post"><input type="hidden" name="entity" value="analysis"><input type="hidden" name="id" value={record.id}><input type="hidden" name="locale" value="zh-TW"><label>Translator <input name="translator_name" value={zh.translator_name??''}></label><label class="checkbox"><input type="checkbox" name="translation_credit_public" checked={zh.translation_credit_public??true}> Public credit</label><button name="operation" value="review">Mark human reviewed</button><button name="operation" value="human">Mark human translated</button><button name="operation" value="publish">Publish translation</button><button name="operation" value="unpublish">Unpublish</button></form>}</div></section>}

{section==='library' &&editing&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="resource"><input type="hidden" name="id" value={record?.id??''}><section class="form-section"><h2>Basic</h2><div class="form-grid"><div class="field full"><label>Official title</label><input name="official_title" value={record?.official_title??''} required><small>Never use a filename as a title. Confirm against an official page or document.</small></div><div class="field"><label>Slug</label><input name="slug" value={record?.slug??''} required pattern="[a-z0-9]+(?:-[a-z0-9]+)*"></div><div class="field"><label>Short title</label><input name="short_title" value={record?.short_title??''}></div><div class="field"><label>Organisation</label><select name="organisation_id" required><option value="">Select…</option>{organisations.map(o=><option value={o.id} selected={record?.organisation_id===o.id}>{o.name}</option>)}</select></div><div class="field"><label>Resource hub</label><select name="hub_id" required><option value="">Select…</option>{hubs.map(h=><option value={h.id} selected={record?.hub_id===h.id}>{h.title}</option>)}</select></div><div class="field"><label>Resource type</label><select name="resource_type_id" required>{types.map(t=><option value={t.id} selected={record?.resource_type_id===t.id}>{t.name}</option>)}</select></div><div class="field full"><label>Description</label><textarea name="description" required>{record?.description??''}</textarea></div><div class="field full"><span>Areas</span>{areas?.map(a=><label class="checkbox"><input type="checkbox" name="area_ids" value={a.id} checked={record?.resource_areas?.some((x:any)=>x.area_id===a.id)}>{a.display_name}</label>)}</div></div></section><section class="form-section"><h2>Source</h2><div class="form-grid"><div class="field full"><label>Official URL</label><div style="display:flex;gap:8px"><input type="url" name="official_url" value={record?.official_url??''} required><button type="submit" name="operation" value="fetch_metadata">Fetch metadata</button></div></div><div class="field full"><label>Source page URL</label><input type="url" name="source_page_url" value={record?.source_page_url??''}></div><div class="field"><label>Format</label><select name="format">{['Web','PDF','XLSX','CSV','DOCX','ZIP','Dataset','API','Interactive Tool','Interactive Map','Video','Slides','Other'].map(x=><option selected={record?.format===x}>{x}</option>)}</select></div><div class="field"><label>Original filename (internal only)</label><input name="original_filename" value={record?.original_filename??''}></div><div class="field"><label>Document code</label><input name="document_code" value={record?.document_code??''}></div><div class="field"><label>Title source</label><select name="title_source">{['pdf_metadata','download_page','resource_library','page_heading','manual'].map(x=><option selected={record?.title_source===x}>{x.replaceAll('_',' ')}</option>)}</select></div><label class="checkbox"><input type="checkbox" name="title_verified" checked={record?.title_verified}> I confirmed the exact official title</label>{record&&!record.official_domain_verified&&<div class="field full"><label>Official-domain override note</label><textarea name="domain_override_note">{record.domain_override_note??''}</textarea></div>}</div></section><section class="form-section"><h2>Version & access</h2><div class="form-grid"><div class="field"><label>Year</label><input type="number" name="year" min="1900" max="2200" value={record?.year??''}></div><div class="field"><label>Version</label><input name="version_label" value={record?.version_label??''}></div><div class="field"><label>Publication date</label><input type="date" name="publication_date" value={record?.publication_date??''}></div><div class="field"><label>Status</label><select name="status">{['draft','needs_title_review','needs_review','current','archived'].map(x=><option selected={record?.status===x}>{x.replaceAll('_',' ')}</option>)}</select></div><div class="field"><label>Language</label><input name="language" value={record?.language??'en'}></div><div class="field"><label>Access</label><select name="access">{['public','free_registration','subscription','paid','reference_only'].map(x=><option selected={record?.access===x}>{x.replaceAll('_',' ')}</option>)}</select></div><div class="field"><label>Update frequency</label><select name="update_frequency">{['weekly','monthly','quarterly','semiannual','annual','event_driven','manual'].map(x=><option selected={record?.update_frequency===x}>{x.replaceAll('_',' ')}</option>)}</select></div><label class="checkbox"><input type="checkbox" name="published" checked={record?.published}> Publish to public Library</label>{record?.supersedes_resource_id&&<label class="checkbox"><input type="checkbox" name="archive_previous" checked> Archive the previous version when this version is published</label>}</div></section><section class="form-section"><h2>GIS data <small>Only complete fields supported by the official source.</small></h2><div class="form-grid">{[['data_theme','Data theme'],['data_type','Data type'],['platform_or_sensor','Platform or sensor'],['spatial_resolution','Spatial resolution'],['temporal_resolution','Temporal resolution'],['temporal_coverage','Temporal coverage'],['geographic_coverage','Geographic coverage'],['processing_level','Processing level'],['data_format','Data format'],['license','License'],['documentation_url','Documentation URL']].map(([name,label])=><div class="field"><label>{label}</label><input name={name} value={record?.[name]??''}></div>)}<label class="checkbox"><input type="checkbox" name="api_available" checked={record?.api_available}> API available</label></div></section><div class="form-actions"><button class="primary">Save</button><a class="admin-button" href="/admin/library/">Cancel</a>{record&&<><button name="operation" value="check">Check now</button><button name="operation" value="new_version">Create new version</button><button name="operation" value="favorite">Pin to Quick Access</button></>}</div></form>}

{section==='hubs'&&editing&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="hub"><input type="hidden" name="id" value={record?.id??''}><section class="form-section"><h2>Resource hub</h2><div class="form-grid"><div class="field"><label>Title</label><input name="title" value={record?.title??''} required></div><div class="field"><label>Slug</label><input name="slug" value={record?.slug??''} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required></div><div class="field"><label>Organisation</label><select name="organisation_id" required>{organisations.map(o=><option value={o.id} selected={record?.organisation_id===o.id}>{o.name}</option>)}</select></div><div class="field"><label>Status</label><select name="status">{['draft','published','archived'].map(x=><option selected={record?.status===x}>{x}</option>)}</select></div><div class="field full"><label>Description</label><textarea name="description" required>{record?.description??''}</textarea></div><div class="field full"><label>Official website</label><input type="url" name="official_website" value={record?.official_website??''}></div><div class="field full"><span>Areas</span>{areas?.map(a=><label class="checkbox"><input type="checkbox" name="area_ids" value={a.id} checked={record?.resource_hub_areas?.some((x:any)=>x.area_id===a.id)}>{a.display_name}</label>)}</div></div>{record&&<p>{record.official_resources?.length??0} linked resources · {(record.official_resources??[]).filter((x:any)=>x.health==='broken').length} broken · {(record.official_resources??[]).filter((x:any)=>x.next_review_at&&new Date(x.next_review_at).getTime() < Date.now()).length} review due</p>}</section><div class="form-actions"><button class="primary">Save hub</button><a class="admin-button" href="/admin/hubs/">Cancel</a></div></form>}

{section==='organisations'&&editing&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="organisation"><input type="hidden" name="id" value={record?.id??''}><section class="form-section"><h2>Organisation</h2><div class="form-grid"><div class="field"><label>Name</label><input name="name" value={record?.name??''} required></div><div class="field"><label>Slug</label><input name="slug" value={record?.slug??''} required></div><div class="field full"><label>Description</label><textarea name="description">{record?.description??''}</textarea></div><div class="field full"><label>Official website</label><input type="url" name="official_website" value={record?.official_website??''} required></div><div class="field"><label>Aliases (comma separated)</label><input name="aliases" value={(record?.aliases??[]).join(', ')}></div><div class="field"><label>Official domains (comma separated)</label><input name="domains" value={(record?.organisation_domains??[]).map((x:any)=>x.domain).join(', ')} required></div><label class="checkbox"><input type="checkbox" name="active" checked={record?.active??true}> Active</label></div></section><div class="form-actions"><button class="primary">Save</button><a class="admin-button" href="/admin/organisations/">Cancel</a></div></form>}

{section.startsWith('website/')&&section!=='website/expertise'&&<form action="/api/admin/save" method="post"><input type="hidden" name="entity" value="site_content"><input type="hidden" name="page_key" value={section.split('/')[1]}><section class="form-section"><h2>English and 中文 page content</h2><p class="notice">Public routes and system relationships stay locked. Edit the words visitors see in each language.</p>{rows.length?rows.map(r=><fieldset style="border:0;border-top:1px solid var(--line);padding:18px 0"><legend><strong>{r.section_key}</strong> · {r.locale}</legend><input type="hidden" name="row_id" value={r.id}><input type="hidden" name={`content_keys_${r.id}`} value={Object.keys(r.content).join(',') }><div class="form-grid">{Object.entries(r.content).map(([key,value])=><div class={`field ${String(value).length>100?'full':''}`}><label>{key.replaceAll(/([A-Z])/g,' $1')}</label>{String(value).length>100?<textarea name={`field_${r.id}_${key}`}>{String(value)}</textarea>:<input name={`field_${r.id}_${key}`} value={String(value)} readonly={key.toLowerCase().includes('link')&&String(value).startsWith('/')}/>}</div>)}</div></fieldset>):<p class="empty">Initial content appears after the database seed is applied.</p>}</section><div class="form-actions"><button class="primary">Save website content</button></div></form>}

{section==='website/about'&&<section class="form-section"><div class="page-head"><div><h2>CV items</h2><p>Add, edit, remove or reorder experience, education, credentials, languages and tools.</p></div></div>{profileItems.map(item=><form action="/api/admin/save" method="post" style="border-top:1px solid var(--line);padding:15px 0"><input type="hidden" name="entity" value="profile_item"><input type="hidden" name="id" value={item.id}><div class="form-grid"><div class="field"><label>Type</label><select name="kind">{['experience','education','teaching','credential','language','tool'].map(x=><option selected={item.kind===x}>{x}</option>)}</select></div><div class="field"><label>Language</label><select name="locale"><option selected={item.locale==='en'}>en</option><option selected={item.locale==='zh-TW'}>zh-TW</option></select></div><div class="field"><label>Title</label><input name="title" value={item.title} required></div><div class="field"><label>Organisation</label><input name="organisation" value={item.organisation??''}></div><div class="field"><label>Start</label><input name="start_label" value={item.start_label??''}></div><div class="field"><label>End</label><input name="end_label" value={item.end_label??''}></div><div class="field full"><label>Summary</label><textarea name="summary">{item.summary??''}</textarea></div><div class="field"><label>Order</label><input type="number" name="sort_order" value={item.sort_order}></div><label class="checkbox"><input type="checkbox" name="active" checked={item.active}> Active</label></div><div class="actions" style="margin-top:10px"><button class="primary">Save item</button><button name="operation" value="delete">Delete</button></div></form>)}<form action="/api/admin/save" method="post" style="border-top:1px solid var(--line);padding-top:18px"><input type="hidden" name="entity" value="profile_item"><div class="form-grid"><div class="field"><label>New item type</label><select name="kind">{['experience','education','teaching','credential','language','tool'].map(x=><option>{x}</option>)}</select></div><div class="field"><label>Language</label><select name="locale"><option>en</option><option>zh-TW</option></select></div><div class="field"><label>Title</label><input name="title" required></div><div class="field"><label>Organisation</label><input name="organisation"></div><div class="field full"><label>Summary</label><textarea name="summary"></textarea></div><div class="field"><label>Order</label><input type="number" name="sort_order" value="0"></div><input type="hidden" name="active" value="on"></div><button class="primary" style="margin-top:10px">Add item</button></form></section>}

{section==='website/expertise'&&<section>{rows.map(a=><form class="form-section" action="/api/admin/save" method="post"><input type="hidden" name="entity" value="expertise"><input type="hidden" name="id" value={a.id}><h2>{String(a.sort_order).padStart(2,'0')} · {a.display_name} <small>System key locked: {a.key}</small></h2><div class="form-grid"><div class="field full"><label>Description</label><textarea name="description">{a.description??''}</textarea></div><div class="field full"><label>Summary</label><textarea name="summary">{a.summary??''}</textarea></div><div class="field"><label>Keywords</label><input name="keywords" value={(a.keywords??[]).join(', ')}></div></div><button class="primary" style="margin-top:15px">Save</button></form>)}</section>}

{!editing&&['articles','analyses','library','hubs','organisations'].includes(section)&&<div class="table-wrap"><table class="data-list"><thead><tr><th>Title</th><th>Status</th><th>Context</th><th>Updated / verified</th><th>Actions</th></tr></thead><tbody>{rows.map(r=><tr><td><strong>{section==='articles'||section==='analyses'?getTitle(r):r.official_title??r.title??r.name}</strong><br><small>{r.slug}</small></td><td><span class={`status ${r.status??(r.active?'current':'archived')}`}>{r.status??(r.active?'active':'inactive')}</span>{r.health&&<><br><span class={`status ${r.health}`}>{r.health}</span></>}</td><td>{r.expertise_areas?.display_name??r.organisations?.name??r.official_website}{r.resource_types&&<> · {r.resource_types.name}</>}{r.official_resources&&<> · {r.official_resources.length} resources</>}</td><td>{r.publication_date??r.last_verified_at?.slice(0,10)??r.updated_at?.slice(0,10)??'—'}</td><td><div class="actions"><a class="admin-button" href={`/admin/${section}/?id=${r.id}`}>Edit</a><form action="/api/admin/save" method="post"><input type="hidden" name="entity" value={section==='library'?'resource':section.slice(0,-1)}><input type="hidden" name="id" value={r.id}><button name="operation" value="delete">Delete</button></form></div></td></tr>)}</tbody></table>{!rows.length&&<p class="empty">No entries yet.</p>}</div>}

{(section==='system/health'||section==='system/review-due')&&<div class="table-wrap"><table class="data-list"><thead><tr><th>Resource</th><th>Health</th><th>HTTP</th><th>Last checked</th><th>Next review</th><th>Action</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.official_title}<br><small>{r.organisations?.name}</small></td><td><span class={`status ${r.health}`}>{r.health}</span></td><td>{r.http_status??'—'}</td><td>{r.last_http_check_at?.slice(0,10)??'Never'}</td><td>{r.next_review_at?.slice(0,10)??'Manual'}</td><td><form class="actions" action="/api/admin/save" method="post"><input type="hidden" name="entity" value="resource"><input type="hidden" name="id" value={r.id}><button name="operation" value="check">Check now</button><button name="operation" value="verify">Mark verified today</button></form></td></tr>)}</tbody></table>{!rows.length&&<p class="empty">No resources require attention.</p>}</div>}

{section==='media'&&<><form class="form-section" action="/api/admin/media" method="post" enctype="multipart/form-data"><h2>Upload your own website media</h2><p>Official documents and third-party files must remain external links.</p><div class="form-grid"><div class="field"><label>Image</label><input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/svg+xml" required></div><div class="field"><label>Alt text</label><input name="alt_text" required></div><div class="field full"><label>Caption</label><input name="caption"></div></div><button class="primary" style="margin-top:15px">Upload</button></form><div class="admin-grid">{rows.map(r=><form class="panel" action="/api/admin/media-manage" method="post"><input type="hidden" name="id" value={r.id}><strong>{r.filename}</strong><p><small>{r.mime_type} · {Math.round(r.size_bytes/1024)} KB</small></p><div class="field"><label>Alt text</label><input name="alt_text" value={r.alt_text} required></div><div class="field"><label>Caption</label><input name="caption" value={r.caption??''}></div><div class="field"><label>Description</label><textarea name="description">{r.description??''}</textarea></div><div class="actions"><button class="primary" name="operation" value="update">Save</button><button name="operation" value="delete">Delete unused</button></div></form>)}</div></>}
{section==='messages'&&<div class="table-wrap"><table class="data-list"><thead><tr><th>Received</th><th>From</th><th>Subject</th><th>Message</th><th>Status</th></tr></thead><tbody>{rows.map(r=><tr><td>{new Date(r.created_at).toLocaleString('en-GB')}</td><td><strong>{r.name}</strong><br><a href={`mailto:${r.email}`}>{r.email}</a></td><td>{r.subject??'—'}</td><td>{r.message}</td><td><span class={`status ${r.status}`}>{r.status}</span></td></tr>)}</tbody></table></div>}
{section==='system/audit'&&<div class="table-wrap"><table class="data-list"><thead><tr><th>Time</th><th>Admin</th><th>Action</th><th>Entity</th></tr></thead><tbody>{rows.map(r=><tr><td>{new Date(r.created_at).toLocaleString('en-GB')}</td><td>{r.admin_users?.email??'System'}</td><td>{r.action}</td><td>{r.entity_type} {r.entity_id??''}</td></tr>)}</tbody></table></div>}
{section==='system/settings'&&<section class="panel"><h2>System settings</h2>{rows.map(r=><div style="border-top:1px solid var(--line);padding:14px 0"><strong>{r.key}</strong><pre style="white-space:pre-wrap">{JSON.stringify(r.value,null,2)}</pre></div>)}</section>}
</AdminLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('button[value="fetch_metadata"]').forEach(button=>button.addEventListener('click',async event=>{event.preventDefault();const form=button.closest('form')!;const input=form.querySelector<HTMLInputElement>('[name="official_url"]')!;if(!input.value)return;button.disabled=true;button.textContent='Fetching…';try{const response=await fetch(`/api/admin/metadata?url=${encodeURIComponent(input.value)}`);const data=await response.json();if(!response.ok)throw new Error(data?.error||'Fetch failed');const title=form.querySelector<HTMLInputElement>('[name="official_title"]')!;const source=form.querySelector<HTMLSelectElement>('[name="title_source"]')!;const filename=form.querySelector<HTMLInputElement>('[name="original_filename"]')!;if(data.suggestedTitle&&!title.value)title.value=data.suggestedTitle;if(data.titleSource)source.value=data.titleSource;if(data.originalFilename&&!filename.value)filename.value=decodeURIComponent(data.originalFilename);window.alert(`Suggested title: ${data.suggestedTitle||'Not found'}\nHTTP: ${data.httpStatus??'Unknown'}\nDomain: ${data.domain}\n\nReview the suggestion, then confirm the title manually.`)}catch(error){window.alert(String(error))}finally{button.disabled=false;button.textContent='Fetch metadata'}}));
</script>
