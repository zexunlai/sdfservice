---
import AdminLayout from '../../layouts/AdminLayout.astro';import{getAdminContext}from'../../lib/supabase';export const prerender=false;const{client}=await getAdminContext(Astro.request,Astro.cookies,Astro.locals);if(!client)return Astro.redirect('/login/',303);const id=Astro.url.searchParams.get('id'),creating=Astro.url.searchParams.has('new');const list=await client.from('glossary_terms').select('id,canonical_english_term,preferred_chinese_term,acronym,status,translation_rule,public_definition_enabled,updated_at').neq('status','archived').order('canonical_english_term');let term:any=null;if(id){const r=await client.from('glossary_terms').select('*,glossary_term_translations(*),glossary_sources(*)').eq('id',id).single();term=r.data}const en=term?.glossary_term_translations?.find((x:any)=>x.locale==='en')??{},zh=term?.glossary_term_translations?.find((x:any)=>x.locale==='zh-TW')??{},source=term?.glossary_sources??{};const editing=Boolean(id||creating);
---
<AdminLayout title="Glossary"><div class="page-head"><div><h1>Glossary</h1><p>One private terminology source for translation, editorial QA and approved public definitions.</p></div>{!editing&&<a class="admin-button primary" href="/admin/glossary/?new=1">+ Add glossary term</a>}</div>{editing?<form action="/api/admin/glossary" method="post"><input type="hidden" name="id" value={term?.id??''}><section class="form-section"><h2>Concept and preferred terminology</h2><div class="form-grid"><div class="field"><label>Canonical English term</label><input name="canonical_english_term" value={term?.canonical_english_term??''} required></div><div class="field"><label>Acronym</label><input name="acronym" value={term?.acronym??''}></div><div class="field"><label>Preferred English</label><input name="preferred_english_term" value={term?.preferred_english_term??''} required></div><div class="field"><label>Preferred 中文</label><input name="preferred_chinese_term" value={term?.preferred_chinese_term??''}></div><div class="field"><label>English variants</label><input name="english_variants" value={(term?.english_variants??[]).join(', ')}></div><div class="field"><label>中文 variants</label><input name="chinese_variants" value={(term?.chinese_variants??[]).join(', ')}></div><div class="field"><label>Terms to avoid EN</label><input name="avoid_english" value={(term?.avoid_english??[]).join(', ')}></div><div class="field"><label>Terms to avoid 中文</label><input name="avoid_chinese" value={(term?.avoid_chinese??[]).join(', ')}></div><div class="field"><label>Translation rule</label><select name="translation_rule">{['preferred','must_use','keep_original','keep_acronym','do_not_translate','context_dependent'].map(x=><option selected={term?.translation_rule===x}>{x.replaceAll('_',' ')}</option>)}</select></div><div class="field"><label>Status</label><select name="status">{['approved','review','deprecated','archived'].map(x=><option selected={term?.status===x}>{x}</option>)}</select></div><label class="checkbox"><input type="checkbox" name="case_sensitive" checked={term?.case_sensitive}> Case sensitive</label></div></section><section class="form-section"><h2>Reader definitions</h2><div class="form-grid"><div class="field"><label>English display term</label><input name="en_display" value={en.display_term??term?.preferred_english_term??''}></div><div class="field"><label>中文顯示詞</label><input name="zh-TW_display" value={zh.display_term??term?.preferred_chinese_term??''}></div><div class="field full"><label>English definition</label><textarea name="en_definition">{en.definition??''}</textarea></div><div class="field full"><label>中文定義</label><textarea name="zh-TW_definition">{zh.definition??''}</textarea></div><div class="field"><label>Definition type</label><select name="definition_type">{['official','adapted_official','ze_xun_lai','other_original'].map(x=><option selected={term?.definition_type===x}>{x.replaceAll('_',' ')}</option>)}</select></div><div class="field"><label>Display rule</label><select name="public_display_rule">{['first_occurrence_only','every_occurrence','manual_only'].map(x=><option selected={term?.public_display_rule===x}>{x.replaceAll('_',' ')}</option>)}</select></div><label class="checkbox"><input type="checkbox" name="public_definition_enabled" checked={term?.public_definition_enabled}> Public definition enabled</label><label class="checkbox"><input type="checkbox" name="auto_reference_enabled" checked={term?.auto_reference_enabled}> Suggest in content</label></div></section><section class="form-section"><h2>Source and private notes</h2><input type="hidden" name="definition_source_id" value={source.id??''}><div class="form-grid"><div class="field"><label>Organisation</label><input name="source_organisation" value={source.organisation??''}></div><div class="field"><label>Official document title</label><input name="source_title" value={source.official_title??''}></div><div class="field full"><label>Official URL</label><input type="url" name="source_url" value={source.official_url??''}></div><div class="field"><label>Year / version</label><input name="source_version" value={source.year_or_version??''}></div><div class="field full"><label>Internal notes (never public)</label><textarea name="internal_notes">{term?.internal_notes??''}</textarea></div></div></section><div class="form-actions"><button class="primary">Save term</button><a class="admin-button" href="/admin/glossary/">Cancel</a>{term&&<button name="operation" value="delete">Archive</button>}</div></form>:<div class="table-wrap"><table class="data-list"><thead><tr><th>English term</th><th>Preferred 中文</th><th>Rule</th><th>Status</th><th>Public</th><th></th></tr></thead><tbody>{(list.data??[]).map(t=><tr><td><strong>{t.canonical_english_term}</strong>{t.acronym&&<><br><small>{t.acronym}</small></>}</td><td>{t.preferred_chinese_term??'—'}</td><td>{t.translation_rule.replaceAll('_',' ')}</td><td><span class={`status ${t.status}`}>{t.status}</span></td><td>{t.public_definition_enabled?'Definition enabled':'Private only'}</td><td><a class="admin-button" href={`/admin/glossary/?id=${t.id}`}>Edit</a></td></tr>)}</tbody></table></div>}</AdminLayout>
