---
import BaseLayout from '../layouts/BaseLayout.astro';
import publications from '../data/publications.json';
const base=`${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Publications" description="HTML articles and PDF publications published directly from the SDFService repository."><header class="page-intro container"><span class="eyebrow">Publications</span><h1>Articles and PDFs.</h1><p>Published directly from this repository. Add an HTML file, a PDF, or both to <code>articles/</code>, then push to publish it here.</p></header><section class="section"><div class="container"><div class="publication-grid">{publications.map(item=><article><div class="meta">Static publication</div><h2>{item.title}</h2><div class="actions">{item.html&&<a class="button" href={`${base}articles/${item.html}`}>Read HTML</a>}{item.pdf&&<a class="text-link" href={`${base}articles/${item.pdf}`} target="_blank" rel="noreferrer">Open PDF ↗</a>}</div></article>)}</div>{!publications.length&&<p class="empty">No standalone HTML or PDF publication has been added yet.</p>}</div></section></BaseLayout>
<style>code{font-family:Arial,'Microsoft JhengHei',sans-serif;background:var(--paper-2);padding:2px 5px}.publication-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 36px}.publication-grid article{padding:25px 0 32px;border-top:1px solid var(--line)}.publication-grid h2{text-transform:capitalize}.actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.empty{color:var(--muted)}@media(max-width:700px){.publication-grid{grid-template-columns:1fr}}</style>
