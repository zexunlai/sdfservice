---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlossaryContent from '../../../components/GlossaryContent.astro';
import { getAnalyses, getHubBySlug, getResourceBySlug, getPublicGlossaryDefinitions } from '../../../lib/platform-data';
export const prerender = false;
const slug = Astro.params.slug!;
const [hub, resource, analyses] = await Promise.all([getHubBySlug(Astro.locals, slug), getResourceBySlug(Astro.locals, slug), getAnalyses(Astro.locals, 'zh-TW')]);
const analysis = (analyses as any[]).find((item) => item.slug === slug);
const definitions=analysis?await getPublicGlossaryDefinitions(Astro.locals,analysis.contentLocale):[];
if (!hub && !resource && !analysis) Astro.response.status = 404;
const title = hub?.title ?? resource?.official_title ?? analysis?.title ?? '找不到資源';
const description = hub?.description ?? resource?.description ?? analysis?.summary ?? '找不到此資源。';
---
<BaseLayout title={title} description={description}>
  <header class="page-intro reading"><span class="eyebrow">{analysis ? '我的分析' : '官方資源'}</span><h1>{title}</h1><p>{description}</p>{analysis?.fallback&&<p class="language-note">English original · Chinese translation not yet available</p>}{analysis&&!analysis.fallback&&analysis.contentLocale!==analysis.sourceLanguage&&<p class="language-note">{analysis.translationStatus==='human_translated'&&analysis.translationCreditPublic&&analysis.translatorName?`Translated by ${analysis.translatorName}`:analysis.translationStatus==='machine_translated_human_reviewed'?'Machine translation reviewed':'Machine translated using Google Translate'}</p>}</header>
  {analysis && <div class="reading prose"><GlossaryContent html={analysis.bodyHtml} definitions={definitions}/></div>}
  {resource && <section class="reading facts"><p><strong>機構：</strong>{resource.organisations.name}</p><p><strong>資源類型：</strong>{resource.resource_types.name}</p><p><strong>最後驗證：</strong>{resource.last_verified_at?.slice(0,10) ?? '尚未記錄'}</p><a class="button" href={resource.official_url} rel="noreferrer">開啟官方來源 ↗</a></section>}
  {hub && <section class="reading facts"><p>{hub.organisations.name}</p><a class="button" href={`/library/${hub.slug}/`}>查看完整資源列表 →</a></section>}
</BaseLayout>
<style>.language-note{font-size:.78rem;color:var(--muted);border-left:2px solid var(--blue);padding-left:10px}.prose,.facts{padding-bottom:80px}.facts{border-top:1px solid var(--line);padding-top:24px}</style>
