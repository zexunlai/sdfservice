---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { expertise } from '../../config/expertise';
import { getAnalyses, getPublishedArticles, getSiteSection, searchResources } from '../../lib/platform-data';
export const prerender = false;

const path = Astro.params.path ?? '';
const homeContent = await getSiteSection(Astro.locals, 'home', 'hero', 'zh-TW');
const staticPages: Record<string, { title:string; eyebrow:string; heading:string; description:string }> = {
  '': { title:'環境情報與永續知識平台', eyebrow:'Ze-Xun Lai · Environmental Intelligence', heading:homeContent?.headline ?? '連結環境系統、空間與市場的專業知識。', description:homeContent?.description ?? '運用環境框架、空間證據與方法學研究，將複雜的環境問題轉化為更清楚的分析與決策。' },
  expertise: { title:'專業領域', eyebrow:'專業領域', heading:'五個相互連結的領域', description:'我的工作與研究關注環境系統、空間分析及新興永續框架之間的交會。' },
  insights: { title:'觀點文章', eyebrow:'觀點文章', heading:'文章與分析', description:'以長篇文章整理公共框架、環境證據與決策之間的關係。' },
  library: { title:'方法與官方資源圖書館', eyebrow:'資料庫', heading:'方法與官方資源圖書館', description:'連結原創分析與官方方法、框架、標準、資料集及技術資源的專業參考系統。' },
  about: { title:'關於 Ze-Xun Lai', eyebrow:'關於', heading:'Ze-Xun Lai', description:'永續專業工作者，具地理學與空間分析背景，關注環境框架、資料、空間脈絡與實務決策的連結。' },
  contact: { title:'聯絡', eyebrow:'聯絡', heading:'一起討論共同關心的問題', description:'歡迎就永續與氣候變遷、地理空間情報、生物多樣性與自然、循環經濟，以及碳市場與方法學交流與合作。' },
  privacy: { title:'隱私權與 Cookie', eyebrow:'法律資訊', heading:'隱私權與 Cookie', description:'本網站不使用廣告、行為追蹤 Cookie 或分析服務。完整政策目前提供英文版本。' },
  disclaimer: { title:'免責聲明與使用條款', eyebrow:'法律資訊', heading:'免責聲明與使用條款', description:'網站內容僅供資訊與教育用途，不構成法律、財務、投資或專業顧問建議。完整條款目前提供英文版本。' },
};
const area = path.startsWith('expertise/') ? expertise.find((item) => item.slug === path.split('/')[1]) : null;
const page = area ? { title:area.title, eyebrow:'專業領域', heading:area.title, description:area.description } : staticPages[path];
if (!page) Astro.response.status = 404;
const [articles, analyses, resourceResult] = await Promise.all([
  path === 'insights' ? getPublishedArticles(Astro.locals, 'zh-TW') : Promise.resolve([]),
  path === 'library' ? getAnalyses(Astro.locals, 'zh-TW') : Promise.resolve([]),
  path === 'library' ? searchResources(Astro.locals, { pageSize:20 }) : Promise.resolve({resources:[],count:0,configured:false}),
]);
---
<BaseLayout title={page?.title ?? '找不到頁面'} description={page?.description ?? '找不到此頁面。'}>
  <header class="page-intro container"><span class="eyebrow">{page?.eyebrow ?? '404'}</span><h1>{page?.heading ?? '找不到頁面'}</h1><p>{page?.description}</p></header>
  {path === 'expertise' && <section class="section"><div class="container list">{expertise.map((item) => <article><span>{item.number}</span><h2>{item.title}</h2><a href={`/zh-TW/expertise/${item.slug}/`}>深入了解 →</a></article>)}</div></section>}
  {area && <section class="section"><div class="reading"><p class="notice">此領域的詳細內容目前使用英文版本；中文內容可在管理介面中逐步補充。</p><a class="text-link" href={`/expertise/${area.slug}/`}>閱讀完整內容 →</a></div></section>}
  {path === 'insights' && <section class="section"><div class="container entries">{articles.map((item) => <article><span>{item.area}</span><h2><a href={`/zh-TW/insights/${item.slug}/`}>{item.title}</a></h2><p>{item.summary}</p></article>)}{!articles.length && <p>目前尚無已發布文章。</p>}</div></section>}
  {path === 'library' && <section class="section"><div class="container entries"><h2>我的分析</h2>{analyses.map((item:any) => <article><span>{item.area}</span><h3><a href={`/zh-TW/library/${item.slug}/`}>{item.title}</a></h3><p>{item.summary}</p></article>)}<h2>官方資源</h2>{resourceResult.resources.map((item:any) => <article><span>{item.organisations.name} · {item.resource_types.name}</span><h3><a href={`/zh-TW/library/${item.slug}/`}>{item.official_title}</a></h3><p>{item.description}</p></article>)}{!analyses.length && !resourceResult.resources.length && <p>尚無已驗證並發布的資源。</p>}</div></section>}
  {(path === 'privacy' || path === 'disclaimer') && <section class="section"><div class="reading"><a class="text-link" href={`/${path}/`}>閱讀英文完整版本 →</a></div></section>}
</BaseLayout>
<style>.list article{display:grid;grid-template-columns:50px 1fr 120px;padding:22px 0;border-top:1px solid var(--line)}.list span,.entries span{color:var(--muted);font-size:.75rem}.list h2{font-size:clamp(1.6rem,4vw,3rem)}.list a,.entries a{font-size:.8rem}.notice{font-family:var(--serif);font-size:1.25rem}.entries article{padding:22px 0;border-top:1px solid var(--line)}.entries h2,.entries h3{margin:8px 0;font-size:clamp(1.5rem,3vw,2.4rem)}.entries h2 a,.entries h3 a{font-size:inherit;text-decoration:none}@media(max-width:620px){.list article{grid-template-columns:35px 1fr}.list a{grid-column:2}}</style>
