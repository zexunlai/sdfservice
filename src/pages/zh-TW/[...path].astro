---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { expertise } from '../../config/expertise';

export const corePages = [
  { path: undefined, title: '環境情報與永續知識平台', eyebrow: 'Ze-Xun Lai · Environmental Intelligence', heading: '連結環境系統、空間與市場的專業知識。', description: '運用環境框架、空間證據與方法學研究，將複雜的環境問題轉化為更清楚的分析與決策。' },
  { path: 'expertise', title: '專業領域', eyebrow: '專業領域', heading: '五個相互連結的領域', description: '我的工作與研究關注環境系統、空間分析及新興永續框架之間的交會。' },
  { path: 'insights', title: '觀點文章', eyebrow: '觀點文章', heading: '文章與分析', description: '以長篇文章整理公共框架、環境證據與決策之間的關係。' },
  { path: 'library', title: '方法學資料庫', eyebrow: '資料庫', heading: '方法學資料庫', description: '整理環境分析與決策所使用的方法、框架、標準與分析途徑。' },
  { path: 'about', title: '關於 Ze-Xun Lai', eyebrow: '關於', heading: 'Ze-Xun Lai', description: '永續專業工作者，具地理學與空間分析背景，關注環境框架、資料、空間脈絡與實務決策的連結。' },
  { path: 'contact', title: '聯絡', eyebrow: '聯絡', heading: '一起討論共同關心的問題', description: '歡迎就永續與氣候變遷、地理空間情報、生物多樣性與自然、循環經濟，以及碳市場與方法學交流與合作。' },
  { path: 'privacy', title: '隱私權與 Cookie', eyebrow: '法律資訊', heading: '隱私權與 Cookie', description: '本網站目前不使用廣告、行為追蹤 Cookie 或分析服務。完整政策目前提供英文版本。' },
  { path: 'disclaimer', title: '免責聲明與使用條款', eyebrow: '法律資訊', heading: '免責聲明與使用條款', description: '網站內容僅供資訊與教育用途，不構成法律、財務、投資或專業顧問建議。完整條款目前提供英文版本。' },
  ...expertise.map((area) => ({ path: `expertise/${area.slug}`, title: area.title, eyebrow: '專業領域', heading: area.title, description: area.description })),
];

type CorePage = (typeof corePages)[number];
export function getStaticPaths() { return corePages.map((page) => ({ params: { path: page.path }, props: { page } })); }
const { page } = Astro.props as { page: CorePage };
---
<BaseLayout title={page.title} description={page.description}>
  <header class="page-intro container"><span class="eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1><p>{page.description}</p></header>
  {page.path === 'expertise' && <section class="section"><div class="container list">{expertise.map((area) => <article><span>{area.number}</span><h2>{area.title}</h2><a href={`/zh-TW/expertise/${area.slug}/`}>深入了解 →</a></article>)}</div></section>}
  {(page.path === 'insights' || page.path === 'library') && <section class="section"><div class="container"><p class="notice">既有內容目前僅提供英文版本；切換至中文後仍可開啟各篇內容。</p><a class="text-link" href={`/${page.path}/`}>瀏覽英文內容 →</a></div></section>}
  {(page.path === 'privacy' || page.path === 'disclaimer') && <section class="section"><div class="reading"><a class="text-link" href={`/${page.path}/`}>閱讀英文完整版本 →</a></div></section>}
</BaseLayout>
<style>.list article{display:grid;grid-template-columns:50px 1fr 120px;padding:22px 0;border-top:1px solid var(--line)}.list span{color:var(--muted);font-size:.75rem}.list h2{font-size:clamp(1.6rem,4vw,3rem)}.list a{font-size:.8rem}.notice{font-family:var(--serif);font-size:1.25rem}@media(max-width:620px){.list article{grid-template-columns:35px 1fr}.list a{grid-column:2}}</style>
