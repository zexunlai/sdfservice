---
import BaseLayout from '../layouts/BaseLayout.astro'; import {expertise} from '../config/expertise'; const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Expertise',description:'Five connected areas of environmental work and research.',url:new URL('/expertise/',Astro.site).toString()};
---
<BaseLayout title="Expertise" description="Five areas: sustainability and climate change, geospatial intelligence, biodiversity and nature, circular economy, and carbon markets and methodologies." schema={schema}><header class="page-intro container"><span class="eyebrow">Expertise</span><h1>Five areas of work.</h1><p>My work and research interests sit at the intersection of environmental systems, spatial analysis and emerging sustainability frameworks.</p></header><section class="container areas">{expertise.map(area=><article><span>{area.number}</span><div><h2>{area.title}</h2><p>{area.description}</p><div class="keywords">{area.themes.slice(0,4).map(word=><small>{word}</small>)}</div></div><a href={`/expertise/${area.slug}/`}>Explore more →</a></article>)}</section></BaseLayout>
<style>.areas{padding-bottom:110px}.areas>article{display:grid;grid-template-columns:60px 1fr 130px;gap:25px;padding:30px 0;border-top:1px solid var(--line)}.areas article>span{font-size:.73rem;color:var(--muted)}.areas h2{font-size:clamp(1.8rem,4vw,3.4rem)}.areas p{max-width:58ch;color:var(--muted);margin-top:10px}.areas article>a{font-size:.75rem;text-transform:uppercase;font-weight:600}.keywords{display:flex;gap:7px;flex-wrap:wrap}.keywords small{color:var(--muted)}.keywords small+small::before{content:'·';margin-right:7px}@media(max-width:680px){.areas>article{grid-template-columns:35px 1fr}.areas article>a{grid-column:2}}</style>
