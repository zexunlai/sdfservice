---
import BaseLayout from '../layouts/BaseLayout.astro';
const domains=[
{n:'01',title:'Geospatial Intelligence',lead:'Location is not a backdrop. It is an analytical dimension.',body:'GIS, spatial analysis and remote sensing help reveal how environmental conditions, assets, communities and decisions relate across space. This domain sits at the centre of my practice, connecting evidence from climate, nature, materials and markets.',items:['Spatial analysis and GIS','Remote sensing','Environmental risk screening','Map-based communication']},
{n:'02',title:'Sustainability & Climate',lead:'Frameworks become useful when they clarify decisions.',body:'I examine how climate and sustainability concepts translate into defined questions, evidence, indicators and management choices—while keeping the limits of each framework visible.',items:['Climate frameworks','Environmental indicators','Risk and opportunity analysis','Decision-focused synthesis']},
{n:'03',title:'Biodiversity & Nature',lead:'Nature-related questions are always place-specific.',body:'Biodiversity dependencies, impacts and risks vary by ecosystem and location. Spatial context can strengthen screening, prioritisation and the interpretation of nature-related information.',items:['Dependencies and impacts','Nature-related risk','Location-specific context','Biodiversity data']},
{n:'04',title:'Circular Economy',lead:'Circularity requires system boundaries and measurement.',body:'Circular economy analysis looks beyond recycling toward material flows, product life cycles, value retention and the evidence needed to evaluate whether strategies change outcomes.',items:['Material systems','Circular strategies','Measurement approaches','Standards research']},
{n:'05',title:'Carbon Markets & Methodologies',lead:'A carbon credit begins with a set of rules.',body:'Methodologies shape what is eligible, how baselines are set, what evidence is monitored and how uncertainty is managed. I study their design and the wider systems in which they operate.',items:['Methodology design','Additionality and baselines','MRV and integrity','Article 6']}
];
---
<BaseLayout title="Expertise" description="Five connected fields: geospatial intelligence, sustainability, biodiversity, circular economy and carbon markets."><header class="page-intro container"><span class="eyebrow">Expertise</span><h1>Five fields. One environmental perspective.</h1><p>My work and research connect spatial thinking with environmental frameworks, measurement and decision-making.</p></header><div class="domains">{domains.map(d=><section class="section"><div class="container layout"><div><span class="number">{d.n}</span><h2>{d.title}</h2></div><div><h3>{d.lead}</h3><p>{d.body}</p><ul>{d.items.map(x=><li>{x}</li>)}</ul></div></div></section>)}</div></BaseLayout>
<style>.domains section:nth-child(even){background:var(--paper-2)}.layout{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.number{font-size:.75rem;color:var(--muted)}h2{margin-top:18px}.layout h3{font-family:var(--sans);font-size:1.1rem;font-weight:600;line-height:1.4}.layout p{color:var(--muted);max-width:55ch}.layout ul{list-style:none;margin:28px 0 0;padding:0}.layout li{border-top:1px solid var(--line);padding:10px 0}@media(max-width:700px){.layout{grid-template-columns:1fr}.layout>div+div{margin-top:25px}}</style>
