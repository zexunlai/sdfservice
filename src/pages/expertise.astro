---
import BaseLayout from '../layouts/BaseLayout.astro'; import {expertise} from '../data/expertise'; const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Expertise',description:'Five connected areas of environmental work and research.',url:new URL('/expertise/',Astro.site).toString()}; const intersections=['GIS × Biodiversity','GIS × Carbon Markets','Climate × Strategy','Circular Economy × Business','Nature × Business','Carbon Markets × Decarbonisation'];
---
<BaseLayout title="Expertise" description="Five connected areas: geospatial intelligence, sustainability and climate, biodiversity and nature, circular economy, and carbon markets." schema={schema}><header class="page-intro container"><span class="eyebrow">Expertise</span><h1>Five areas of work.</h1><p>My work and research interests sit at the intersection of environmental systems, spatial analysis and emerging sustainability frameworks.</p></header><section class="container areas">{expertise.map(area=><a href={`/expertise/${area.slug}/`}><span>{area.number}</span><div><h2>{area.title}</h2><p>{area.description}</p><div class="keywords">{area.themes.slice(0,4).map(word=><small>{word}</small>)}</div></div><strong>Explore →</strong></a>)}</section><section class="section connections"><div class="container"><div class="section-head"><span class="eyebrow">Where the fields connect</span><div><h2>Shared questions across disciplines.</h2><p>Environmental decisions often sit between fields. These intersections guide how I connect spatial evidence, frameworks and measurable outcomes.</p></div></div><div class="matrix">{intersections.map(item=><span>{item}</span>)}</div></div></section></BaseLayout>
<style>.areas{padding-bottom:110px}.areas>a{display:grid;grid-template-columns:60px 1fr 100px;gap:25px;padding:30px 0;border-top:1px solid var(--line);text-decoration:none}.areas>a>span{font-size:.73rem;color:var(--muted)}.areas h2{font-size:clamp(1.8rem,4vw,3.4rem)}.areas p{max-width:58ch;color:var(--muted);margin-top:10px}.areas>a>strong{font-size:.75rem;text-transform:uppercase}.keywords{display:flex;gap:7px;flex-wrap:wrap}.keywords small{color:var(--muted)}.keywords small+small::before{content:'·';margin-right:7px}.connections{background:var(--paper-2)}.matrix{display:grid;grid-template-columns:repeat(3,1fr)}.matrix span{padding:18px 0;border-top:1px solid var(--line)}@media(max-width:680px){.areas>a{grid-template-columns:35px 1fr}.areas>a>strong{grid-column:2}.matrix{grid-template-columns:1fr}}</style>
