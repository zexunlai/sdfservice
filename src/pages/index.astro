---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content'; import {expertise} from '../data/expertise';
const insights=(await getCollection('insights',({data})=>!data.draft)).filter(x=>x.data.featured).slice(0,4); const research=(await getCollection('research',({data})=>!data.draft)).slice(0,6); const person={'@context':'https://schema.org','@type':'Person',name:'Ze-Xun Lai',alumniOf:{'@type':'CollegeOrUniversity',name:'National Taiwan University'},knowsAbout:expertise.map(x=>x.title)};
---
<BaseLayout title="Ze-Xun Lai" description="Sustainability, geospatial intelligence and carbon markets — research, frameworks and practical analysis." schema={person}>
<section class="hero"><div class="container"><span class="eyebrow">Sustainability · GIS · Carbon Markets</span><h1>Sustainability,<br/><em>Geospatial Intelligence</em><br/>& Carbon Markets</h1><div class="hero-copy"><p>Working across sustainability, GIS, biodiversity, circular economy and carbon markets to translate complex environmental challenges into practical analytical and strategic insights.</p><small>Based in Taiwan, working with global environmental frameworks, standards and methodologies.</small><div class="actions"><a class="button" href="/expertise/">Explore expertise</a><a class="secondary" href="/insights/">Read insights →</a></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Five areas</span><div><h2>Environmental questions across connected systems.</h2></div></div><div class="domains">{expertise.map(area=><a href={`/expertise/${area.slug}/`}><span>{area.number}</span><h3>{area.title}</h3><p>{area.description}</p><strong>Explore →</strong></a>)}</div></div></section>
<section class="section featured"><div class="container"><div class="section-head"><span class="eyebrow">Featured insights</span><div><h2>Notes for better environmental decisions.</h2></div></div><div class="insights">{insights.map(({id,data})=><article><span class="meta">{data.category}</span><h3><a href={`/insights/${id}/`}>{data.title}</a></h3><p>{data.description}</p></article>)}</div><a class="text-link all" href="/insights/">View all insights →</a></div></section>
<section class="section exploring"><div class="container"><div><span class="eyebrow">Currently exploring</span><h2>Questions in progress.</h2></div><ol>{research.map(({data},i)=><li><span>0{i+1}</span>{data.title}</li>)}</ol></div></section>
<section class="section about-preview"><div class="container"><span class="eyebrow">About</span><div><h2>A geographic perspective on sustainability.</h2><p>A sustainability professional working at the intersection of geospatial analysis, climate, biodiversity, circular economy and carbon markets.</p><p class="education">B.Sc. in Geography · National Taiwan University</p><a class="text-link" href="/about/">Learn more →</a></div></div></section>
<section class="section contact-band"><div class="container"><span class="eyebrow">Contact</span><h2>Interested in the same questions?</h2><a class="button" href="/contact/">Get in touch</a></div></section>
</BaseLayout>
<style>.hero{padding:clamp(75px,10vw,135px) 0 clamp(80px,10vw,130px);overflow:hidden;position:relative}.hero:after{content:'';position:absolute;width:40vw;height:40vw;right:-12vw;top:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;transform:rotate(8deg);opacity:.35}.hero .container{position:relative;z-index:1}.hero em{font-weight:400;color:var(--forest)}.hero-copy{max-width:67ch;margin:55px 0 0 28%}.hero-copy>p{font-family:var(--serif);font-size:1.3rem}.hero-copy small{color:var(--muted)}.actions{display:flex;gap:22px;align-items:center;margin-top:28px}.secondary{font-size:.86rem;font-weight:600}.domains{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink)}.domains a{padding:20px 15px 15px;border-right:1px solid var(--line);text-decoration:none}.domains a:first-child{border-left:1px solid var(--line)}.domains span{font-size:.7rem;color:var(--muted)}.domains h3{font-size:1.55rem;min-height:3em;margin:28px 0 14px}.domains p{font-size:.84rem;color:var(--muted)}.domains strong{font-size:.72rem;text-transform:uppercase}.featured{background:var(--paper-2)}.insights{display:grid;grid-template-columns:1fr 1fr;gap:0 32px}.insights article{padding:24px 0;border-top:1px solid var(--line)}.insights h3 a{text-decoration:none}.insights p{color:var(--muted)}.all{display:inline-block;margin-top:35px}.exploring .container,.about-preview .container{display:grid;grid-template-columns:1fr 2fr;gap:6vw}.exploring ol{list-style:none;padding:0;margin:0}.exploring li{padding:14px 0;border-top:1px solid var(--line)}.exploring li span{display:inline-block;width:42px;color:var(--muted);font-size:.7rem}.about-preview{background:var(--paper-2)}.about-preview p{max-width:58ch;font-family:var(--serif);font-size:1.25rem}.about-preview .education{font-family:var(--sans);font-size:.85rem;color:var(--muted)}.contact-band{text-align:center}.contact-band h2{margin:15px 0 30px}@media(max-width:850px){.domains{grid-template-columns:1fr 1fr}.domains a:last-child{grid-column:1/-1}.hero-copy{margin-left:0}}@media(max-width:650px){.hero h1{font-size:2.85rem}.actions{align-items:flex-start;flex-direction:column}.domains{display:block}.domains a{display:block;border-left:1px solid var(--line)}.domains h3{min-height:auto;margin:12px 0}.insights,.exploring .container,.about-preview .container{grid-template-columns:1fr}.exploring ol{margin-top:35px}}</style>
