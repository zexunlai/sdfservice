---
import BaseLayout from '../layouts/BaseLayout.astro';import { expertise } from '../config/expertise';import insightData from '../data/pdf-insights.json';import type { PdfInsight } from '../types/insights';
const insights=insightData as PdfInsight[];
const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;const featured=insights.slice(0,5);
---
<BaseLayout title="Ze-Xun Lai — Environmental Intelligence" description="Environmental intelligence across systems, space and markets."><section class="hero"><div class="container"><span class="eyebrow">Ze-Xun Lai · Environmental Intelligence</span><h1>Environmental intelligence across systems, space and markets.</h1><div class="hero-copy"><p>Applying environmental frameworks, spatial evidence and methodological research to turn complex environmental questions into clearer analysis and decisions.</p><small>Based in Taipei, Taiwan.</small><a class="hero-cta" href={`${base}expertise/`}>Explore expertise →</a></div></div></section><section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Five areas</span><div><h2>Environmental questions across connected systems.</h2></div></div><div class="domains">{expertise.map(area=><article><span>{area.number}</span><h3>{area.title}</h3><p>{area.description}</p><a href={`${base}expertise/${area.slug}/`}>Explore more →</a></article>)}</div></div></section><section class="section featured"><div class="container"><div class="section-head"><span class="eyebrow">Latest insights</span><div><h2>Published research PDFs.</h2></div></div><div class="insights">{featured.map(item=><article><div class="meta">{item.area}</div><h3>{item.title}</h3><a class="read" href={`${base}insights/${item.file}`} target="_blank" rel="noreferrer">Open PDF ↗</a></article>)}{!featured.length&&<p class="empty">New research PDFs will appear here when published.</p>}<a class="all" href={`${base}insights/`}><span>All insights</span><strong>Browse by area →</strong></a></div></div></section><section class="section library"><div class="container"><div><span class="eyebrow">Methods & Resources Library</span><h2>Methods & Resources Library</h2><p>Original methodology analyses alongside verified official resources.</p></div><a class="text-link" href={`${base}library/`}>Explore the library →</a></div></section><section class="section contact-band"><div class="container"><span class="eyebrow">Contact</span><h2>Have a question or idea to discuss?</h2><a class="button" href={`${base}contact/`}>Let’s connect</a></div></section></BaseLayout>
<style>.hero{padding:clamp(72px,9vw,120px) 0 clamp(80px,10vw,130px);position:relative;overflow:hidden}.hero:after{content:'';position:absolute;width:38vw;height:38vw;right:-12vw;top:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;transform:rotate(8deg);opacity:.3}.hero .container{position:relative;z-index:1}.hero h1{font-size:clamp(3.2rem,7vw,6.3rem);max-width:13ch}.hero-copy{max-width:62ch;margin:45px 0 0 35%}.hero-copy p{font-family:var(--serif);font-size:1.3rem}.hero-copy small,.hero-cta{display:block}.hero-copy small,.empty{color:var(--muted)}.hero-cta{margin-top:25px;font-size:.82rem;text-transform:uppercase;font-weight:600}.domains{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink)}.domains article{padding:20px 15px;border-right:1px solid var(--line)}.domains article:first-child{border-left:1px solid var(--line)}.domains h3{font-size:1.5rem;min-height:3.2em;margin:26px 0 12px}.domains p{font-size:.84rem;color:var(--muted)}.domains a,.read{font-size:.72rem;text-transform:uppercase;font-weight:600}.featured{background:var(--paper-2)}.insights{display:grid;grid-template-columns:1fr 1fr;gap:0 34px}.insights article,.all{padding:24px 0;border-top:1px solid var(--line)}.all{display:flex;flex-direction:column;justify-content:space-between;min-height:180px;text-decoration:none;color:var(--forest)}.library .container{display:flex;justify-content:space-between;gap:7vw}.contact-band{text-align:center}.contact-band h2{margin:15px 0 30px}@media(max-width:850px){.domains{grid-template-columns:1fr 1fr}.hero-copy{margin-left:0}}@media(max-width:650px){.domains,.insights{display:block}.domains article,.insights article{border-left:1px solid var(--line)}.library .container{display:block}}</style>
