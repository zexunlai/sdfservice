---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection} from 'astro:content';
const insights=(await getCollection('insights',({data})=>!data.draft)).filter(x=>x.data.featured).slice(0,3);
const research=(await getCollection('research',({data})=>!data.draft)).slice(0,6);
const person={'@context':'https://schema.org','@type':'Person',name:'Zexun Lai',jobTitle:'Sustainability professional',alumniOf:{'@type':'CollegeOrUniversity',name:'National Taiwan University'},knowsAbout:['Geospatial intelligence','Sustainability','Biodiversity','Circular economy','Carbon markets']};
const domains=[['01','Geospatial Intelligence','Spatial analysis, GIS and remote sensing as core ways of understanding environmental systems and decisions.'],['02','Sustainability & Climate','Connecting environmental frameworks, climate questions and measurable management responses.'],['03','Biodiversity & Nature','Examining nature-related dependencies, impacts and risks through ecological and place-based perspectives.'],['04','Circular Economy','Exploring how material systems, circular strategies and measurement can support better resource decisions.'],['05','Carbon Markets & Methodologies','Reading carbon standards and methodologies with attention to integrity, evidence and implementation.']];
---
<BaseLayout title="Zexun Lai" description="Sustainability, geospatial intelligence and carbon markets — research, frameworks and practical analysis." schema={person}>
<section class="hero"><div class="container"><div class="eyebrow">Sustainability · GIS · Carbon Markets</div><h1>Sustainability,<br/><em>Geospatial Intelligence</em><br/>& Carbon Markets</h1><div class="hero-foot"><p>Working across sustainability, GIS, biodiversity, circular economy and carbon markets to translate complex environmental challenges into practical analytical and strategic insights.</p><span>Based in Taiwan, working with global environmental frameworks, standards and methodologies.</span></div></div><div class="coordinates">25.0330° N&nbsp;&nbsp; 121.5654° E</div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Five fields · one perspective</span><div><h2>Environmental intelligence across connected systems.</h2><p>No environmental challenge sits neatly inside one discipline. These five domains form a shared analytical practice.</p></div></div><div class="domains">{domains.map(([n,t,d])=><a href="/expertise/" class="domain"><span>{n}</span><h3>{t}</h3><p>{d}</p><b>Explore domain →</b></a>)}</div></div></section>
<section class="section connection geo-panel"><div class="container"><div><span class="eyebrow">Where the fields connect</span><h2>Place reveals the relationships that categories miss.</h2></div><div><p>Geospatial thinking provides a common language for climate, nature, materials and carbon analysis.</p><svg viewBox="0 0 600 330" role="img" aria-label="Network connecting the five expertise domains"><g fill="none" stroke="currentColor" opacity=".45"><path d="M70 80L300 35L530 90L450 270L170 275L70 80M300 35L170 275M530 90L170 275M70 80L450 270"/></g><g fill="#b8a47d"><circle cx="70" cy="80" r="7"/><circle cx="300" cy="35" r="7"/><circle cx="530" cy="90" r="7"/><circle cx="450" cy="270" r="7"/><circle cx="170" cy="275" r="7"/></g><g fill="currentColor" font-size="12" font-family="sans-serif"><text x="20" y="65">GIS</text><text x="260" y="20">CLIMATE</text><text x="490" y="75">NATURE</text><text x="430" y="300">CIRCULAR</text><text x="100" y="305">CARBON</text></g></svg></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Featured insights</span><div><h2>Notes for better environmental decisions.</h2><a class="text-link" href="/insights/">Read all insights →</a></div></div><div class="grid">{insights.map(({id,data})=><article class="card insight"><a class="card-link" href={`/insights/${id}/`}><div class="meta"><span>{data.category}</span></div><h3>{data.title}</h3><p>{data.description}</p><span class="text-link">Read essay →</span></a></article>)}</div></div></section>
<section class="section library"><div class="container"><div class="section-head"><span class="eyebrow">Methodology library</span><div><h2>Carbon methodologies, read carefully.</h2><p>A structured library for comparing purpose, applicability, baselines, additionality, monitoring and integrity considerations. Entries are published only after source review.</p><a class="button" href="/methodologies/">Open the library</a></div></div></div></section>
<section class="section exploring"><div class="container grid"><div class="explore-title"><span class="eyebrow">Currently exploring</span><h2>Questions in progress.</h2></div><ol>{research.map(({data})=><li>{data.title}</li>)}</ol></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Selected research & projects</span><div><h2>Building public tools for structured learning.</h2><p>Selected work focuses on organizing public knowledge, testing analytical approaches and making complex environmental topics easier to examine.</p><a class="text-link" href="/projects/">View projects →</a></div></div></div></section>
<section class="section about-band"><div class="container grid"><div><span class="eyebrow">About</span><h2>A geographic perspective on sustainability.</h2></div><div><p>I am a sustainability professional working at the intersection of geospatial analysis, climate, biodiversity, circular economy and carbon markets.</p><a class="text-link" href="/about/">More about my perspective →</a></div></div></section>
<section class="section contact-band"><div class="container"><span class="eyebrow">Start a conversation</span><h2>Interested in the same questions?</h2><a class="button" href="/contact/">Get in touch</a></div></section>
</BaseLayout>
<style>
.hero{min-height:calc(100vh - 72px);padding:clamp(65px,10vw,130px) 0 40px;position:relative;overflow:hidden}.hero:before{content:'';position:absolute;right:-10vw;top:4vh;width:48vw;height:48vw;border:1px solid var(--line);background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:54px 54px;transform:rotate(8deg);opacity:.42}.hero .container{position:relative}.hero em{color:var(--forest);font-weight:400}.hero-foot{display:grid;grid-template-columns:1.3fr .7fr;gap:60px;margin:clamp(50px,8vw,110px) 0 0 25%}.hero-foot p{font-family:var(--serif);font-size:1.3rem}.hero-foot span{font-size:.85rem;color:var(--muted)}.coordinates{position:absolute;right:24px;bottom:20px;font-size:.67rem;letter-spacing:.12em;color:var(--muted);writing-mode:vertical-rl}.domains{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}.domain{padding:22px 16px;border-right:1px solid var(--line);text-decoration:none}.domain:first-child{border-left:1px solid var(--line)}.domain>span{font-size:.72rem;color:var(--muted)}.domain h3{min-height:3.1em;margin:35px 0 20px}.domain p{font-size:.85rem}.domain b{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}.connection .container{display:grid;grid-template-columns:1.4fr .6fr;gap:90px}.connection .eyebrow{color:var(--sand)}.connection p{font-size:1.1rem;align-self:end}.insight{grid-column:span 4}.library{background:var(--paper-2)}.explore-title{grid-column:span 5}.exploring ol{grid-column:7/span 6;margin:0;padding:0;list-style:none;counter-reset:item}.exploring li{counter-increment:item;border-top:1px solid var(--line);padding:15px 0}.exploring li:before{content:'0' counter(item);font-size:.7rem;color:var(--muted);margin-right:22px}.about-band{background:var(--paper-2)}.about-band .grid>div{grid-column:span 6}.about-band p{font-family:var(--serif);font-size:1.5rem}.contact-band{text-align:center}.contact-band h2{margin:18px 0 32px}@media(max-width:850px){.domains{grid-template-columns:1fr 1fr}.domain:last-child{grid-column:span 2}.hero-foot{margin-left:0}.connection .container{grid-template-columns:1fr}.connection p{margin-top:30px}}@media(max-width:600px){.hero{min-height:auto}.hero h1{font-size:2.9rem}.hero-foot{grid-template-columns:1fr;gap:10px}.domains{display:block}.domain{display:block;border-left:1px solid var(--line)}.domain h3{min-height:auto;margin:15px 0}.coordinates{display:none}}
</style>
<style>.connection svg{width:100%;height:auto;margin-top:20px}</style>
