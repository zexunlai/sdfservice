---
import BaseLayout from '../layouts/BaseLayout.astro';
import { expertise } from '../config/expertise';
import { getAnalyses, getPublishedArticles, getSiteSection, searchResources } from '../lib/platform-data';
export const prerender=false;
const published=await getPublishedArticles(Astro.locals,'en');
const featured=expertise.map(area=>published.filter(x=>x.area===area.title||x.areaKey===area.slug).sort((a,b)=>String(b.publicationDate).localeCompare(String(a.publicationDate)))[0]).filter(Boolean);
const resourceResult=await searchResources(Astro.locals,{pageSize:50}); const analyses=await getAnalyses(Astro.locals,'en');
const counts=new Map(expertise.map(area=>[area.title,resourceResult.resources.filter((r:any)=>r.resource_areas?.some((x:any)=>x.expertise_areas?.key===area.slug)).length+analyses.filter((x:any)=>x.areaKey===area.slug).length]));
const dateFormat=new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'}); const hero=await getSiteSection(Astro.locals,'home','hero','en'); const sections=await getSiteSection(Astro.locals,'home','sections','en');
const person={'@context':'https://schema.org','@type':'Person',name:'Ze-Xun Lai',alumniOf:{'@type':'CollegeOrUniversity',name:'National Taiwan University'},knowsAbout:expertise.map(x=>x.title)};
---
<BaseLayout title="Ze-Xun Lai — Environmental Intelligence" description="Environmental intelligence across systems, space and markets." schema={person}>
<section class="hero"><div class="container"><span class="eyebrow">{hero?.eyebrow??'Ze-Xun Lai · Environmental Intelligence'}</span><h1>{hero?.headline??'Environmental intelligence across systems, space and markets.'}</h1><div class="hero-copy"><p>{hero?.description??'Applying environmental frameworks, spatial evidence and methodological research to turn complex environmental questions into clearer analysis and decisions.'}</p><small>{hero?.location??'Based in Taipei, Taiwan.'}</small><a class="hero-cta" href={hero?.ctaLink??'/expertise/'}>{hero?.ctaText??'Explore expertise'} →</a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Five areas</span><div><h2>{sections?.areasHeading??'Environmental questions across connected systems.'}</h2></div></div><div class="domains">{expertise.map(area=><article><span>{area.number}</span><h3>{area.title}</h3><p>{area.description}</p><a href={`/expertise/${area.slug}/`}>Explore more →</a></article>)}</div></div></section>
<section class="section featured"><div class="container"><div class="section-head"><span class="eyebrow">Featured insights</span><div><h2>{sections?.featuredHeading??'Recent analysis from each area.'}</h2></div></div><div class="insights">{featured.map(article=><article><div class="meta"><span>{article.area}</span><time datetime={article.publicationDate}>{dateFormat.format(new Date(`${article.publicationDate}T00:00:00`))}</time></div><h3><a href={`/insights/${article.slug}/`}>{article.title}</a></h3><p>{article.summary}</p></article>)}<a class="all" href="/insights/"><span>All articles</span><strong>View all insights →</strong></a></div></div></section>
<section class="section library"><div class="container"><div><span class="eyebrow">Methods & Resources Library</span><h2>{sections?.libraryHeading??'Methods & Resources Library'}</h2><p>{sections?.libraryDescription??'A curated reference system connecting original analysis with official methods, frameworks, standards, datasets and technical resources across environmental practice.'}</p></div><div class="library-areas">{expertise.map(area=><div><span>{area.title}</span>{(counts.get(area.title)??0)>0&&<small>{counts.get(area.title)} published</small>}</div>)}<a class="text-link" href="/library/">Explore the library →</a></div></div></section>
<section class="section about-preview"><div class="container"><span class="eyebrow">About</span><div><h2>Ze-Xun Lai</h2><p>{sections?.aboutPreview??'A sustainability professional with a background in geography, working across sustainability and environmental intelligence.'}</p><p class="education">B.Sc. in Geography · National Taiwan University</p><a class="text-link" href="/about/">Learn more →</a></div></div></section>
<section class="section contact-band"><div class="container"><span class="eyebrow">Contact</span><h2>{sections?.contactHeading??'Have a question or idea to discuss?'}</h2><a class="button" href="/contact/">{sections?.contactText??'Let’s connect'} →</a></div></section>
</BaseLayout>
<style>.hero{padding:clamp(72px,9vw,120px) 0 clamp(80px,10vw,130px);position:relative;overflow:hidden}.hero:after{content:'';position:absolute;width:38vw;height:38vw;right:-12vw;top:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;transform:rotate(8deg);opacity:.3}.hero .container{position:relative;z-index:1}.hero h1{font-size:clamp(3.2rem,7vw,6.3rem);max-width:13ch}.hero-copy{max-width:62ch;margin:45px 0 0 35%}.hero-copy p{font-family:var(--serif);font-size:1.3rem}.hero-copy small,.hero-cta{display:block}.hero-copy small{color:var(--muted)}.hero-cta{margin-top:25px;font-size:.82rem;text-transform:uppercase;font-weight:600}.domains{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink)}.domains article{padding:20px 15px;border-right:1px solid var(--line)}.domains article:first-child{border-left:1px solid var(--line)}.domains article>span{font-size:.7rem;color:var(--muted)}.domains h3{font-size:1.5rem;min-height:3.2em;margin:26px 0 12px}.domains p{font-size:.84rem;color:var(--muted)}.domains a{font-size:.72rem;text-transform:uppercase;font-weight:600}.featured{background:var(--paper-2)}.insights{display:grid;grid-template-columns:1fr 1fr;gap:0 34px}.insights article,.all{padding:24px 0;border-top:1px solid var(--line)}.insights h3 a{text-decoration:none}.insights p{color:var(--muted)}.all{display:flex;flex-direction:column;justify-content:space-between;min-height:230px;text-decoration:none;color:var(--forest)}.all span{font-family:var(--serif);font-size:2rem}.all strong{font-size:.8rem;text-transform:uppercase}.library .container,.about-preview .container{display:grid;grid-template-columns:1fr 1fr;gap:7vw}.library h2{margin:16px 0 22px}.library p{color:var(--muted)}.library-areas>div{display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid var(--line)}.library-areas small{color:var(--muted)}.library-areas .text-link{display:inline-block;margin-top:25px}.about-preview{background:var(--paper-2)}.about-preview p{max-width:60ch;font-family:var(--serif);font-size:1.2rem}.about-preview .education{font:400 .85rem var(--sans);color:var(--muted)}.contact-band{text-align:center}.contact-band h2{margin:15px 0 30px}@media(max-width:850px){.domains{grid-template-columns:1fr 1fr}.domains article:last-child{grid-column:1/-1}.hero-copy{margin-left:0}}@media(max-width:650px){.hero h1{font-size:2.8rem}.domains{display:block}.domains article{border-left:1px solid var(--line)}.domains h3{min-height:auto;margin:12px 0}.insights,.library .container,.about-preview .container{grid-template-columns:1fr}.library-areas{margin-top:35px}}</style>
