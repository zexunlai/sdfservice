---
import '../styles/admin.css';
import { getAdminContext, isSupabaseConfigured } from '../lib/supabase';
export const prerender = false;
const { admin } = await getAdminContext(Astro.request, Astro.cookies, Astro.locals);
if (admin) return Astro.redirect('/admin/', 303);
const configured = isSupabaseConfigured(Astro.locals);
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') || '/admin/';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>Owner sign in | Environmental Intelligence</title><meta name="robots" content="noindex,nofollow"><link rel="icon" href="/favicon.svg"></head><body><main style="min-height:100vh;display:grid;place-items:center;padding:20px"><section class="panel" style="width:min(420px,100%);padding:32px"><img src="/logo.svg" alt="" width="54" height="54"><h1 style="font:500 32px Georgia,serif;margin:18px 0 4px">Ze-Xun Lai</h1><p style="color:var(--muted);margin-top:0">Environmental Intelligence · Owner access</p>{error&&<p class="notice" role="alert">Sign-in failed. Check the email and password.</p>}{!configured&&<p class="notice" role="status">Supabase environment variables are required before sign-in can be used.</p>}<form action="/api/auth/login" method="post" class="form-grid" style="grid-template-columns:1fr;margin-top:25px"><input type="hidden" name="next" value={next}><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><button class="primary" type="submit" disabled={!configured}>Sign in</button></form><p style="font-size:12px;color:var(--muted);margin:20px 0 0">This login is restricted to the site owner. Public registration is unavailable.</p></section></main></body></html>
