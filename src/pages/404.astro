---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=`${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Page not found" description="The requested page could not be found."><section class="not-found geo-panel"><div class="container"><span class="eyebrow">404 · Outside mapped extent</span><h1>This page is not on the map.</h1><p>The address may have changed, or the page may no longer exist.</p><a class="button" href={base}>Return home</a></div></section></BaseLayout><style>.not-found{min-height:75vh;display:grid;place-items:center}.not-found .eyebrow{color:var(--accent)}.not-found h1{max-width:10ch;margin:20px 0}.not-found p{color:var(--muted)}</style>
