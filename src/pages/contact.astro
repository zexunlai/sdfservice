---
import BaseLayout from '../layouts/BaseLayout.astro';
const links={email:'zexunlai@gmail.com',linkedin:'https://www.linkedin.com/in/ze-xun-lai-3646432bb/',location:'Taiwan'};
---
<BaseLayout title="Contact" description="Contact Ze-Xun Lai about environmental intelligence and potential collaboration."><header class="page-intro container"><span class="eyebrow">Contact</span><h1>Let’s connect around shared questions.</h1><p>I welcome conversations and potential collaborations across the five areas of this platform.</p></header><section class="section"><div class="container contact-grid"><div class="contacts"><div><span class="eyebrow">Email</span><h2><a href={`mailto:${links.email}`}>{links.email}</a></h2></div><div><span class="eyebrow">LinkedIn</span><h2><a href={links.linkedin} rel="me noreferrer">Connect on LinkedIn ↗</a></h2></div><div><span class="eyebrow">Location</span><h2>{links.location}</h2></div></div><div class="contact-note"><h2>Send a message</h2><p>This is now a static website, so email is the direct contact channel.</p><a class="button" href={`mailto:${links.email}`}>Email Ze-Xun</a></div></div></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.contacts>div{padding:25px 0;border-top:1px solid var(--line)}.contacts h2{font-size:clamp(1.3rem,3vw,2.4rem)}.contacts a{text-decoration:none}.contact-note{background:var(--paper-2);padding:32px;height:max-content}.contact-note p{color:var(--muted)}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}}</style>
