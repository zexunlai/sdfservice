import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Zexun Lai about sustainability, geospatial intelligence and environmental research."><header class="page-intro container"><span class="eyebrow">Contact</span><h1>Let’s connect around shared questions.</h1><p>If you are exploring sustainability, geospatial analysis, biodiversity, circular economy or carbon methodologies, you are welcome to get in touch.</p></header><section class="section"><div class="container contacts"><div><span class="eyebrow">Email</span><h2><a href="mailto:zexunlai@gmail.com">zexunlai@gmail.com</a></h2></div><div><span class="eyebrow">LinkedIn</span><h2><a href="https://www.linkedin.com/in/ze-xun-lai-3646432bb/" rel="me noreferrer">Connect on LinkedIn ↗</a></h2></div><div><span class="eyebrow">Location</span><h2>Taiwan</h2></div></div></section></BaseLayout>
<style>.contacts>div{display:grid;grid-template-columns:1fr 3fr;gap:30px;padding:34px 0;border-top:1px solid var(--line)}.contacts h2{font-size:clamp(1.5rem,4vw,3.5rem)}.contacts a{text-decoration:none}.contacts a:hover{text-decoration:underline}@media(max-width:650px){.contacts>div{grid-template-columns:1fr}}</style>
