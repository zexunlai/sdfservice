---
import BaseLayout from '../layouts/BaseLayout.astro';import {getSiteSection,getSiteSetting} from '../lib/platform-data';import {isSupabaseConfigured} from '../lib/supabase';export const prerender=false;const copy=await getSiteSection(Astro.locals,'contact','main','en');const links=await getSiteSetting(Astro.locals,'social_links')??{email:'zexunlai@gmail.com',linkedin:'https://www.linkedin.com/in/ze-xun-lai-3646432bb/',location:'Taiwan'};const sent=Astro.url.searchParams.has('sent'),error=Astro.url.searchParams.has('error'),configured=isSupabaseConfigured(Astro.locals);
---
<BaseLayout title="Contact" description="Contact Ze-Xun Lai about environmental intelligence and potential collaboration."><header class="page-intro container"><span class="eyebrow">{copy?.eyebrow??'Contact'}</span><h1>{copy?.heading??'Let’s connect around shared questions.'}</h1><p>{copy?.description??'I welcome conversations and potential collaborations across the five areas of this platform.'}</p></header><section class="section"><div class="container contact-grid"><div class="contacts"><div><span class="eyebrow">Email</span><h2><a href={`mailto:${links.email}`}>{links.email}</a></h2></div><div><span class="eyebrow">LinkedIn</span><h2><a href={links.linkedin} rel="me noreferrer">Connect on LinkedIn ↗</a></h2></div><div><span class="eyebrow">Location</span><h2>{links.location}</h2></div></div>{configured&&<form class="contact-form" action="/api/contact" method="post"><h2>Send a message</h2>{sent&&<p class="success" role="status">Thank you. Your message has been received.</p>}{error&&<p class="error" role="alert">Please check the information and try again.</p>}<div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><label>Name<input name="name" required maxlength="120"></label><label>Email<input name="email" type="email" required maxlength="254"></label><label>Subject<input name="subject" maxlength="200"></label><label>Message<textarea name="message" required minlength="10" maxlength="10000"></textarea></label><button class="button">Send message</button></form>}</div></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.contacts>div{padding:25px 0;border-top:1px solid var(--line)}.contacts h2{font-size:clamp(1.3rem,3vw,2.4rem)}.contacts a{text-decoration:none}.contact-form{display:grid;gap:14px}.contact-form h2{font-size:2.4rem}.contact-form label{display:grid;gap:5px;font-size:.75rem;text-transform:uppercase}.contact-form input,.contact-form textarea{padding:11px;border:1px solid var(--line);background:white;font:inherit}.contact-form textarea{min-height:180px;resize:vertical}.contact-form .button{border:0;width:max-content}.honeypot{position:absolute;left:-9999px}.success{border-left:3px solid var(--forest);padding:10px}.error{border-left:3px solid #8a3f38;padding:10px}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}}</style>
