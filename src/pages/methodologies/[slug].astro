---
import {getCollection,render} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const e=await getCollection('methodologies',({data})=>!data.draft);return e.map(x=>({params:{slug:x.id},props:{entry:x}}))} const {entry}=Astro.props; const {Content}=await render(entry); const d=entry.data;
---
<BaseLayout title={d.title} description={d.description}><header class="page-intro container"><span class="eyebrow">{d.registry} · {d.methodologyId}</span><h1>{d.title}</h1><p>{d.description}</p></header><section class="container table-wrap"><table class="data-table"><tbody><tr><th>Version</th><td>{d.version}</td><th>Status</th><td>{d.status}</td></tr><tr><th>Sector</th><td>{d.sector}</td><th>Project type</th><td>{d.projectType}</td></tr><tr><th>Applicable geography</th><td colspan="3">{d.applicableGeography}</td></tr><tr><th>Baseline</th><td colspan="3">{d.baseline}</td></tr><tr><th>Additionality</th><td colspan="3">{d.additionality}</td></tr><tr><th>MRV</th><td colspan="3">{d.mrv}</td></tr><tr><th>Leakage</th><td colspan="3">{d.leakage}</td></tr><tr><th>Permanence</th><td colspan="3">{d.permanence}</td></tr><tr><th>Crediting period</th><td colspan="3">{d.creditingPeriod}</td></tr></tbody></table></section><section class="section"><div class="reading prose"><Content/></div></section></BaseLayout>
