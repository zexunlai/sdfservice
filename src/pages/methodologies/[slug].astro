---
import { getCollection } from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('library',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id}}));}
const base=`${import.meta.env.BASE_URL}/`;
return Astro.redirect(`${base}library/${Astro.params.slug}/`,301);
