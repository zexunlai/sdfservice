---
import BaseLayout from '../layouts/BaseLayout.astro'; import {getCollection,render} from 'astro:content'; const entries=await getCollection('projects',({data})=>!data.draft);
---
<BaseLayout title="Projects / Selected Research" description="Selected public research and knowledge-organization projects by Zexun Lai."><header class="page-intro container"><span class="eyebrow">Projects / selected research</span><h1>Public knowledge, made easier to navigate.</h1><p>This section will document independent, academic and public knowledge projects built from transparent sources and clearly stated methods.</p></header><section class="section"><div class="container projects">{entries.length===0?<div class="empty"><span class="eyebrow">Selected work</span><h2>Projects will be added as they are ready.</h2><p>The structure is prepared for future project notes without changing the site code.</p></div>:await Promise.all(entries.map(async entry=>{const {Content}=await render(entry);return <article><div class="meta"><span>{entry.data.category}</span><span>{entry.data.status}</span></div><h2>{entry.data.title}</h2><p>{entry.data.description}</p><details><summary>Project notes</summary><div class="prose"><Content/></div></details></article>}))}</div></section></BaseLayout>
<style>.projects article{display:grid;grid-template-columns:1fr 2fr 2fr;gap:32px;border-top:1px solid var(--line);padding:32px 0}.projects h2{font-size:clamp(1.8rem,3vw,3rem)}.projects>article>p,.empty p{color:var(--muted)}details{grid-column:2/-1}summary{cursor:pointer;font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em}.prose{margin-top:28px}.empty{max-width:65ch;padding:50px 0}.empty h2{margin:16px 0}@media(max-width:720px){.projects article{grid-template-columns:1fr}.projects details{grid-column:auto}}</style>
