---
import { expertise } from '../config/expertise';
const base=`${import.meta.env.BASE_URL}/`;
const intro='Environmental questions, examined spatially.';
const copyright='© 2026 Ze-Xun Lai. All rights reserved.'; const location='Based in Taiwan';
---
<footer><div class="container footer-grid"><div class="footer-name"><span class="eyebrow">Ze-Xun Lai</span><h2>{intro}</h2></div><div class="explore"><strong>Explore</strong><a href={`${base}expertise/`}>Expertise</a><a href={`${base}insights/`}>Insights</a><a href={`${base}library/`}>Library</a><a href={`${base}publications/`}>Publications</a><a href={`${base}about/`}>About</a><a href={`${base}contact/`}>Contact</a><a href="https://www.linkedin.com/in/ze-xun-lai-3646432bb/" rel="me noreferrer">LinkedIn ↗</a></div><div class="areas"><strong>Areas</strong>{expertise.map(area=><a href={`${base}expertise/${area.slug}/`}>{area.title}</a>)}</div></div><div class="container base"><span>{copyright}</span><div><a href={`${base}privacy/`}>Privacy</a><a href={`${base}disclaimer/`}>Disclaimer</a><span>{location}</span></div></div></footer>
<style>footer{background:var(--paper-2);color:var(--ink);padding:72px 0 25px;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.6fr;gap:55px}.eyebrow{color:var(--accent)}h2{font-size:clamp(1.9rem,3.5vw,3.25rem);margin-top:16px}.footer-grid>div:not(.footer-name){display:flex;flex-direction:column;gap:8px}.footer-grid strong{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--accent);margin-bottom:8px}.footer-grid a,.base a{color:var(--ink);text-decoration:none;font-size:.84rem}.base{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:60px;padding-top:18px;font-size:.72rem;color:var(--muted)}.base div{display:flex;gap:20px}@media(max-width:700px){.footer-grid{grid-template-columns:1fr 1fr}.footer-name{grid-column:1/-1}.areas{grid-column:2}.base,.base div{display:block}.base a,.base span{display:block;margin-top:7px}}@media(max-width:450px){.footer-grid{grid-template-columns:1fr}.footer-name,.areas{grid-column:auto}}</style>
