---
import {expertise} from '../config/expertise'; const isZh=Astro.url.pathname.startsWith('/zh-TW'); const prefix=isZh?'/zh-TW':'';
---
<footer><div class="container footer-grid"><div class="footer-name"><span class="eyebrow">Ze-Xun Lai</span><h2>Environmental questions,<br/>examined spatially.</h2></div><div class="explore"><strong>{isZh?'探索':'Explore'}</strong><a href={`${prefix}/expertise/`}>{isZh?'專業領域':'Expertise'}</a><a href={`${prefix}/insights/`}>{isZh?'觀點文章':'Insights'}</a><a href={`${prefix}/library/`}>{isZh?'方法學資料庫':'Library'}</a><a href={`${prefix}/about/`}>{isZh?'關於':'About'}</a><a href={`${prefix}/contact/`}>{isZh?'聯絡':'Contact'}</a><a href="https://www.linkedin.com/in/ze-xun-lai-3646432bb/" rel="me noreferrer">LinkedIn ↗</a></div><div class="areas"><strong>{isZh?'領域':'Areas'}</strong>{expertise.map(area=><a href={`${prefix}/expertise/${area.slug}/`}>{area.title}</a>)}</div></div><div class="container base"><span>© 2026 Ze-Xun Lai. All rights reserved.</span><div><a href={`${prefix}/privacy/`}>Privacy & Cookies</a><a href={`${prefix}/disclaimer/`}>Disclaimer & Terms</a><span>Based in Taiwan</span></div></div></footer>
<style>footer{background:var(--ink);color:var(--paper);padding:72px 0 25px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.6fr;gap:55px}.eyebrow{color:var(--sand)}h2{font-size:clamp(1.9rem,3.5vw,3.25rem);margin-top:16px}.footer-grid>div:not(.footer-name){display:flex;flex-direction:column;gap:8px}.footer-grid strong{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--sand);margin-bottom:8px}.footer-grid a,.base a{color:#d8dbd8;text-decoration:none;font-size:.84rem}.base{display:flex;justify-content:space-between;border-top:1px solid rgba(255,255,255,.18);margin-top:60px;padding-top:18px;font-size:.72rem;color:#aeb3af}.base div{display:flex;gap:20px}@media(max-width:700px){.footer-grid{grid-template-columns:1fr 1fr}.footer-name{grid-column:1/-1}.areas{grid-column:2}.base,.base div{display:block}.base a,.base span{display:block;margin-top:7px}}@media(max-width:450px){.footer-grid{grid-template-columns:1fr}.footer-name,.areas{grid-column:auto}}</style>
