---
import BaseLayout from '../layouts/BaseLayout.astro';import type {Expertise} from '../config/expertise';import insightData from '../data/pdf-insights.json';import type {PdfInsight} from '../types/insights';
const insights=insightData as PdfInsight[];
const {area}=Astro.props as {area:Expertise};const rawBase=import.meta.env.BASE_URL;const base=rawBase==='/'?'/':`${rawBase}/`;const related=insights.filter(item=>item.areaKey===area.slug).slice(0,3);
---
<BaseLayout title={area.title} description={area.description}><header class="page-intro container detail-hero"><div><span class="eyebrow">Expertise · {area.number}</span><h1>{area.title}</h1></div><div><p class="statement">{area.statement}</p><p>{area.description}</p></div></header><section class="section"><div class="container two"><span class="eyebrow">What this field means</span><div><h2>{area.statement}</h2><p class="lead">{area.meaning}</p></div></div></section><section class="section"><div class="container split"><div><span class="eyebrow">What I focus on</span><ol>{area.focus.map((item,i)=><li><span>0{i+1}</span>{item}</li>)}</ol></div><div><span class="eyebrow">Key themes</span><ul>{area.themes.map(item=><li>{item}</li>)}</ul></div></div></section><section class="section tools"><div class="container two"><span class="eyebrow">Frameworks & tools</span><div class="terms">{area.frameworks.map(item=><span>{item}</span>)}</div></div></section><section class="section related"><div class="container"><div class="section-head"><span class="eyebrow">Related insights</span><div><h2>Continue reading.</h2><a class="text-link" href={`${base}insights/`}>View all insights →</a></div></div><div class="related-grid">{related.map(item=><article><div class="meta">{item.area}</div><h3>{item.title}</h3><a class="text-link" href={`${base}insights/${item.file}`} target="_blank" rel="noreferrer">Open PDF →</a></article>)}{!related.length&&<p class="empty">No PDF insights have been published in this area yet.</p>}</div></div></section></BaseLayout>
<style>.detail-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:8vw;align-items:end}.detail-hero h1{max-width:9ch}.statement{font-family:var(--serif);font-size:clamp(1.7rem,3vw,2.5rem);color:var(--ink)!important}.two{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.lead{font-family:var(--serif);font-size:1.3rem;color:var(--muted)}.split{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.split ol,.split ul{list-style:none;padding:0;margin:25px 0 0}.split li{padding:14px 0;border-top:1px solid var(--line)}.split li span{display:inline-block;width:40px;font-size:.72rem;color:var(--muted)}.tools{background:var(--paper-2)}.terms,.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.terms span,.related article{padding:15px 0;border-top:1px solid var(--line)}.empty{color:var(--muted)}@media(max-width:760px){.detail-hero,.two,.split,.terms,.related-grid{grid-template-columns:1fr}}</style>
