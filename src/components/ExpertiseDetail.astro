---
import BaseLayout from '../layouts/BaseLayout.astro'; import type {Expertise} from '../config/expertise'; import {getCollection} from 'astro:content';
const {area}=Astro.props as {area:Expertise};
const base=`${import.meta.env.BASE_URL}/`;
const related=(await getCollection('insights',({data})=>!data.draft&&data.area===area.title)).slice(0,3);
const canonical=new URL(`/expertise/${area.slug}/`,Astro.site).toString();
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebPage',name:area.title,description:area.description,url:canonical},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site).toString()},{'@type':'ListItem',position:2,name:'Expertise',item:new URL('/expertise/',Astro.site).toString()},{'@type':'ListItem',position:3,name:area.title,item:canonical}]}]};
---
<BaseLayout title={area.title} description={area.description} schema={schema}>
  <header class="page-intro container detail-hero"><div><span class="eyebrow">Expertise · {area.number}</span><h1>{area.title}</h1></div><div><p class="statement">{area.statement}</p><p>{area.description}</p></div></header>
  <section class="section"><div class="container two"><span class="eyebrow">What this field means</span><div><h2>{area.statement}</h2><p class="lead">{area.meaning}</p></div></div></section>
  <section class="section"><div class="container split"><div><span class="eyebrow">What I focus on</span><ol>{area.focus.map((item,i)=><li><span>0{i+1}</span>{item}</li>)}</ol></div><div><span class="eyebrow">Key themes</span><ul>{area.themes.map(item=><li>{item}</li>)}</ul></div></div></section>
  <section class="section tools"><div class="container two"><span class="eyebrow">Frameworks & tools</span><div class="terms">{area.frameworks.map(item=><span>{item}</span>)}</div></div></section>
  <section class="section"><div class="container two"><span class="eyebrow">Where it connects</span><div class="connections">{area.connections.map(item=><div>{item}</div>)}</div></div></section>
  <section class="section related"><div class="container"><div class="section-head"><span class="eyebrow">Related articles</span><div><h2>Continue reading.</h2><a class="text-link" href={`${base}insights/`}>View all insights →</a></div></div><div class="related-grid">{related.map(item=><article><div class="meta">{item.data.area}</div><h3><a href={`${base}insights/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.description}</p></article>)}</div></div></section>
</BaseLayout>
<style>.detail-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:8vw;align-items:end}.detail-hero h1{max-width:9ch}.statement{font-family:var(--serif);font-size:clamp(1.7rem,3vw,2.5rem);color:var(--ink)!important}.two{display:grid;grid-template-columns:1fr 2fr;gap:5vw}.two h2{max-width:13ch}.lead{font-family:var(--serif);font-size:1.3rem;max-width:58ch;margin-top:28px;color:var(--muted)}.split{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.split ol,.split ul{list-style:none;padding:0;margin:25px 0 0}.split li{padding:14px 0;border-top:1px solid var(--line)}.split li span{display:inline-block;width:40px;font-size:.72rem;color:var(--muted)}.tools{background:var(--paper-2)}.terms{display:grid;grid-template-columns:1fr 1fr}.terms span,.connections div{padding:15px 0;border-top:1px solid var(--line)}.connections{display:grid;grid-template-columns:1fr 1fr;gap:0 30px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.related article{border-top:1px solid var(--ink);padding-top:18px}.related h3 a{text-decoration:none}.related p{color:var(--muted)}@media(max-width:760px){.detail-hero,.two,.split{grid-template-columns:1fr}.detail-hero{align-items:start}.terms,.connections,.related-grid{grid-template-columns:1fr}.detail-hero h1{max-width:12ch}}</style>
