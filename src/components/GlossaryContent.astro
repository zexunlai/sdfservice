---
import{annotateGlossaryHtml,type GlossaryDefinition}from'../lib/glossary';const{html,definitions=[]}=Astro.props as{html:string;definitions:GlossaryDefinition[]};const annotated=annotateGlossaryHtml(html,definitions);
---
<div class="glossary-content" set:html={annotated}/><div class="glossary-popover" role="dialog" aria-label="Terminology definition" hidden><button class="glossary-close" aria-label="Close definition">×</button><strong data-title></strong><p data-definition></p><a data-source-link target="_blank" rel="noreferrer"></a></div>
<script>const popup=document.querySelector<HTMLElement>('.glossary-popover'),title=popup?.querySelector<HTMLElement>('[data-title]'),definition=popup?.querySelector<HTMLElement>('[data-definition]'),source=popup?.querySelector<HTMLAnchorElement>('[data-source-link]');let active:HTMLButtonElement|null=null;function close(){if(!popup)return;popup.hidden=true;active?.setAttribute('aria-expanded','false');active=null}function open(button:HTMLButtonElement){if(!popup||!title||!definition||!source)return;active?.setAttribute('aria-expanded','false');active=button;button.setAttribute('aria-expanded','true');title.textContent=button.dataset.term??'';definition.textContent=button.dataset.definition??'';source.textContent=button.dataset.source?`Source: ${button.dataset.source}`:'';source.href=button.dataset.sourceUrl??'';source.hidden=!source.href;popup.hidden=false;const r=button.getBoundingClientRect();popup.style.top=`${Math.min(window.scrollY+r.bottom+8,document.documentElement.scrollHeight-popup.offsetHeight-16)}px`;popup.style.left=`${Math.max(12,Math.min(r.left,window.innerWidth-popup.offsetWidth-12))}px`}document.querySelectorAll<HTMLButtonElement>('.glossary-term').forEach(b=>{b.addEventListener('click',()=>active===b?close():open(b));b.addEventListener('mouseenter',()=>open(b));b.addEventListener('focus',()=>open(b))});popup?.querySelector('.glossary-close')?.addEventListener('click',close);document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});document.addEventListener('pointerdown',e=>{if(active&&!popup?.contains(e.target as Node)&&!active.contains(e.target as Node))close()});</script>
<style is:global>.glossary-term{font:inherit;color:inherit;background:linear-gradient(transparent 72%,rgba(71,120,135,.2) 0);border:0;border-bottom:1px dotted var(--blue);padding:0;cursor:help}.glossary-term:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.glossary-popover{position:absolute;z-index:50;width:min(360px,calc(100vw - 24px));padding:18px 38px 16px 18px;border:1px solid var(--line);background:var(--paper);box-shadow:0 8px 30px rgba(26,35,31,.16)}.glossary-popover strong{font-family:var(--serif);font-size:1.15rem}.glossary-popover p{margin:.55rem 0}.glossary-popover a{font-size:.75rem}.glossary-close{position:absolute;right:8px;top:7px;border:0;background:none;font-size:1.25rem}</style>
