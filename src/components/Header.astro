---
const links=[['Home','/'],['Expertise','/expertise/'],['Insights','/insights/'],['About','/about/'],['Contact','/contact/']]; const path=Astro.url.pathname; const active=(href:string)=>href==='/'?path==='/':path.startsWith(href);
---
<header class="site-header"><a class="brand" href="/" aria-label="Ze-Xun Lai home"><span>ZL</span><strong>Ze-Xun Lai</strong></a><button class="menu" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true"></span></button><nav id="primary-nav" aria-label="Primary navigation">{links.map(([label,href])=><a href={href} aria-current={active(href)?'page':undefined}><strong>{label}</strong>{label==='Expertise'&&<small>Explore five areas of work</small>}{label==='Insights'&&<small>Articles, research notes and methodologies</small>}</a>)}</nav><span class="language" aria-label="Current language">EN</span></header>
<script>const b=document.querySelector<HTMLButtonElement>('.menu');const n=document.querySelector<HTMLElement>('#primary-nav');function close(){b?.setAttribute('aria-expanded','false');n?.classList.remove('open');document.body.classList.remove('menu-open')}b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));n?.classList.toggle('open',open);document.body.classList.toggle('menu-open',open)});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();b?.focus()}});</script>
<style>.site-header{height:68px;display:flex;align-items:center;padding:0 max(20px,calc((100vw - 1180px)/2));border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30;background:rgba(246,243,236,.94);backdrop-filter:blur(12px)}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;margin-right:auto}.brand span{display:grid;place-items:center;width:32px;height:32px;background:var(--forest);color:white;font-family:var(--serif)}.brand strong{font-size:.9rem}nav{display:flex;align-items:center;gap:26px}nav a{position:relative;text-decoration:none;color:var(--muted);font-size:.82rem;padding:23px 0}nav a strong{font-weight:500}nav a small{display:none}nav a:hover,nav a[aria-current=page]{color:var(--ink)}nav a[aria-current=page]::after{content:'';position:absolute;height:1px;background:var(--forest);left:0;right:0;bottom:15px}.language{margin-left:28px;padding-left:22px;border-left:1px solid var(--line);font-size:.7rem;letter-spacing:.12em}.menu{display:none;border:0;background:transparent;font:inherit;color:var(--ink)}.menu span{width:18px;height:10px;display:inline-block;margin-left:9px;border-top:1px solid;border-bottom:1px solid}@media(max-width:760px){.site-header{height:62px}.language{display:none}.menu{display:flex;align-items:center}nav{display:none;position:absolute;top:62px;left:0;right:0;min-height:calc(100vh - 62px);background:var(--paper);padding:28px max(20px,calc((100vw - 1180px)/2));flex-direction:column;align-items:stretch;gap:0;border-bottom:1px solid var(--line)}nav.open{display:flex}nav a{padding:18px 0;border-top:1px solid var(--line);font-family:var(--serif);font-size:1.55rem;color:var(--ink)}nav a strong{font-weight:400}nav a small{display:block;font:400 .78rem var(--sans);color:var(--muted);margin-top:3px}nav a[aria-current=page]::after{display:none}.menu[aria-expanded=true] span{border-bottom:0;transform:rotate(45deg)}body.menu-open{overflow:hidden}}</style>
