---
import { getSiteSection } from '../lib/platform-data';
const path=Astro.url.pathname; const isZh=path.startsWith('/zh-TW'); const clean=isZh?(path.replace(/^\/zh-TW/,'')||'/'):path; const prefix=isZh?'/zh-TW':'';
const fallback=isZh?{home:'首頁',expertise:'專業領域',insights:'觀點文章',library:'圖書館',about:'關於',contact:'聯絡'}:{home:'Home',expertise:'Expertise',insights:'Insights',library:'Library',about:'About',contact:'Contact'};
const labels={...fallback,...(await getSiteSection(Astro.locals,'header','navigation',isZh?'zh-TW':'en'))}; const links=[[labels.home,'/'],[labels.expertise,'/expertise/'],[labels.insights,'/insights/'],[labels.library,'/library/'],[labels.about,'/about/'],[labels.contact,'/contact/']]; const active=(href:string)=>href==='/'?clean==='/':clean.startsWith(href); const zhHref=`/zh-TW${clean}`;
---
<header class="site-header"><a class="brand" href={`${prefix}/`} aria-label="Ze-Xun Lai — Environmental Intelligence"><img src="/logo.svg" alt=""/><span><strong>Ze-Xun Lai</strong><small>Environmental Intelligence</small></span></a><button class="menu" aria-expanded="false" aria-controls="primary-nav">{isZh?'選單':'Menu'} <span aria-hidden="true"></span></button><nav id="primary-nav" aria-label={isZh?'主要導覽':'Primary navigation'}>{links.map(([label,href])=><a href={`${prefix}${href}`} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav><div class="language" aria-label="Language"><a href={clean} lang="en" aria-current={!isZh?'true':undefined}>EN</a><span>|</span><a href={zhHref} lang="zh-TW" aria-current={isZh?'true':undefined}>中文</a></div></header>
<script>const b=document.querySelector<HTMLButtonElement>('.menu');const n=document.querySelector<HTMLElement>('#primary-nav');function close(){b?.setAttribute('aria-expanded','false');n?.classList.remove('open');document.body.classList.remove('menu-open')}b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));n?.classList.toggle('open',open);document.body.classList.toggle('menu-open',open)});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();b?.focus()}});</script>
<style>.site-header{height:68px;display:flex;align-items:center;padding:0 max(20px,calc((100vw - 1180px)/2));border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30;background:rgba(246,243,236,.94);backdrop-filter:blur(12px)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:auto}.brand img{width:34px;height:34px}.brand span{display:flex;flex-direction:column;line-height:1.15}.brand strong{font-size:.85rem}.brand small{font-size:.65rem;color:var(--muted);letter-spacing:.04em}nav{display:flex;gap:23px}nav a{position:relative;text-decoration:none;color:var(--muted);font-size:.8rem;padding:23px 0}nav a:hover,nav a[aria-current=page]{color:var(--ink)}nav a[aria-current=page]::after{content:'';position:absolute;height:1px;background:var(--forest);left:0;right:0;bottom:15px}.language{display:flex;gap:7px;margin-left:24px;padding-left:18px;border-left:1px solid var(--line);font-size:.7rem}.language a{text-decoration:none;color:var(--muted)}.language a[aria-current=true]{color:var(--ink);font-weight:600}.menu{display:none;border:0;background:transparent;font:inherit}.menu span{width:18px;height:10px;display:inline-block;margin-left:8px;border-top:1px solid;border-bottom:1px solid}@media(max-width:900px){.brand small{display:none}nav{gap:15px}.language{margin-left:14px;padding-left:12px}}@media(max-width:760px){.site-header{height:62px}.menu{display:flex;align-items:center}.language{margin-left:14px}nav{display:none;position:absolute;top:62px;left:0;right:0;min-height:calc(100vh - 62px);background:var(--paper);padding:24px 20px;flex-direction:column;gap:0}nav.open{display:flex}nav a{padding:16px 0;border-top:1px solid var(--line);font-family:var(--serif);font-size:1.45rem;color:var(--ink)}nav a[aria-current=page]::after{display:none}.menu[aria-expanded=true] span{border-bottom:0;transform:rotate(45deg)}body.menu-open{overflow:hidden}}@media(max-width:400px){.language{font-size:.65rem;gap:5px}.brand strong{font-size:.8rem}}</style>
