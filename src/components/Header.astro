---
const base=`${import.meta.env.BASE_URL}/`;
const path=Astro.url.pathname;
const clean=path.startsWith(base) ? `/${path.slice(base.length)}`.replace(/\/{2,}/g,'/') : path;
const links=[['Home',''],['Expertise','expertise/'],['Insights','insights/'],['Library','library/'],['Publications','publications/'],['About','about/'],['Contact','contact/']];
const active=(href:string)=>href===''?clean==='/':clean.startsWith(`/${href}`);
---
<header class="site-header"><a class="brand" href={base} aria-label="Ze-Xun Lai — Environmental Intelligence"><img src={`${base}logo.svg`} alt=""/><span><strong>Ze-Xun Lai</strong><small>Environmental Intelligence</small></span></a><button class="menu" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true"></span></button><nav id="primary-nav" aria-label="Primary navigation">{links.map(([label,href])=><a href={`${base}${href}`} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav></header>
<script>const b=document.querySelector<HTMLButtonElement>('.menu');const n=document.querySelector<HTMLElement>('#primary-nav');function close(){b?.setAttribute('aria-expanded','false');n?.classList.remove('open');document.body.classList.remove('menu-open')}b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));n?.classList.toggle('open',open);document.body.classList.toggle('menu-open',open)});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();b?.focus()}});</script>
<style>.site-header{height:68px;display:flex;align-items:center;padding:0 max(20px,calc((100vw - 1180px)/2));border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30;background:#FFFFFF;backdrop-filter:blur(12px)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:auto}.brand img{width:34px;height:34px}.brand span{display:flex;flex-direction:column;line-height:1.15}.brand strong{font-size:.85rem}.brand small{font-size:.65rem;color:var(--muted);letter-spacing:.04em}nav{display:flex;gap:23px}nav a{position:relative;text-decoration:none;color:var(--muted);font-size:.8rem;padding:23px 0}nav a:hover,nav a[aria-current=page]{color:var(--ink)}nav a[aria-current=page]::after{content:'';position:absolute;height:2px;background:var(--accent);left:0;right:0;bottom:15px}.menu{display:none;border:0;background:transparent;font:inherit}@media(max-width:900px){.brand small{display:none}nav{gap:15px}}@media(max-width:760px){.site-header{height:62px}.menu{display:flex;align-items:center}nav{display:none;position:absolute;top:62px;left:0;right:0;min-height:calc(100vh - 62px);background:var(--paper);padding:24px 20px;flex-direction:column;gap:0}nav.open{display:flex}nav a{padding:16px 0;border-top:1px solid var(--line);font-family:var(--serif);font-size:1.45rem;color:var(--ink)}nav a[aria-current=page]::after{display:none}.menu[aria-expanded=true] span{border-bottom:0;transform:rotate(45deg)}body.menu-open{overflow:hidden}}</style>
