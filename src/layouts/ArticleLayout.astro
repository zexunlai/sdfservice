---
import BaseLayout from './BaseLayout.astro';
const {title,description,date,updated,category,tags=[],author='Zexun Lai'}=Astro.props; const schema={'@context':'https://schema.org','@type':'Article',headline:title,description,author:{'@type':'Person',name:author},datePublished:date?.toISOString(),dateModified:updated?.toISOString()};
---
<BaseLayout title={title} description={description} type="article" schema={schema}><article><header class="page-intro reading"><div class="eyebrow">{category}</div><h1>{title}</h1><p>{description}</p><div class="meta"><span>{author}</span>{date&&<time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB',{year:'numeric',month:'long',day:'numeric'})}</time>}</div></header><div class="reading prose"><slot/></div></article><div class="reading tags">{tags.map((tag:string)=><span class="tag">{tag}</span>)}</div><div class="reading back"><a class="text-link" href="/insights/">← All insights</a></div></BaseLayout>
<style>article{padding-bottom:70px}.page-intro h1{max-width:13ch;font-size:clamp(3rem,7vw,6rem)}.page-intro .meta{margin-top:32px}.tags{display:flex;gap:8px;flex-wrap:wrap;padding-bottom:40px}.back{padding:20px 0 100px;border-top:1px solid var(--line)}</style>
