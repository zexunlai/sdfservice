---
import '../styles/admin.css';
interface Props { title: string; }
const { title } = Astro.props;
const path = Astro.url.pathname;
const groups = [
  { label: '', items: [['Dashboard','/admin/']] },
  { label: 'Content', items: [['Articles','/admin/articles/'],['My Analyses','/admin/analyses/'],['Library','/admin/library/'],['Resource Hubs','/admin/hubs/']] },
  { label: 'Translation', items: [['Translations','/admin/translations/'],['Glossary','/admin/glossary/'],['Terminology QA','/admin/terminology-qa/']] },
  { label: 'Website', items: [['Homepage','/admin/website/homepage/'],['Header','/admin/website/header/'],['Expertise','/admin/website/expertise/'],['About','/admin/website/about/'],['Contact','/admin/website/contact/'],['Footer','/admin/website/footer/'],['Legal','/admin/website/legal/'],['SEO','/admin/website/seo/'],['Social Links','/admin/website/social-links/']] },
  { label: 'Media', items: [['Media Library','/admin/media/']] },
  { label: 'System', items: [['Resource Health','/admin/system/health/'],['Review Due','/admin/system/review-due/'],['Messages','/admin/messages/'],['Organisations','/admin/organisations/'],['Revision History','/admin/history/'],['Settings','/admin/system/settings/'],['Audit Log','/admin/system/audit/']] },
] as const;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{title} | Environmental Intelligence Admin</title><meta name="robots" content="noindex,nofollow"><link rel="icon" href="/favicon.svg"></head><body>
<aside class="admin-sidebar"><a class="admin-brand" href="/admin/"><img src="/logo.svg" alt=""><span><strong>Ze-Xun Lai</strong><small>Environmental Intelligence</small></span></a><nav aria-label="Admin">{groups.map(group=><section>{group.label&&<h2>{group.label}</h2>}{group.items.map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</section>)}</nav></aside>
<div class="admin-shell"><header class="admin-top"><button class="menu-toggle" aria-label="Open admin navigation" aria-expanded="false">Menu</button><span>{title}</span><div><a href="/" target="_blank">View website ↗</a><form action="/api/auth/logout" method="post"><button>Sign out</button></form></div></header><main class="admin-main"><slot/></main></div>
<script>const btn=document.querySelector<HTMLButtonElement>('.menu-toggle');btn?.addEventListener('click',()=>{const open=document.body.classList.toggle('nav-open');btn.setAttribute('aria-expanded',String(open))});</script>
</body></html>
