{
  "name": "zexunlai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log astro dev",
    "build": "NAPI_RS_FORCE_WASI=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_LOG_PATH=.wrangler/wrangler.log astro check && NAPI_RS_FORCE_WASI=false CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_LOG_PATH=.wrangler/wrangler.log astro build",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log astro preview",
    "check": "NAPI_RS_FORCE_WASI=true WRANGLER_LOG_PATH=.wrangler/wrangler.log astro check",
    "typecheck": "NAPI_RS_FORCE_WASI=true WRANGLER_LOG_PATH=.wrangler/wrangler.log astro check",
    "lint": "NAPI_RS_FORCE_WASI=true eslint .",
    "db:verify": "node --import tsx scripts/verify-migrations.ts",
    "db:verify:remote": "node --env-file=.env.local --import tsx scripts/verify-remote.ts",
    "content:export": "node --import tsx scripts/export-markdown.ts",
    "content:import": "node --import tsx scripts/import-markdown.ts",
    "content:verify:remote": "node --env-file=.env.local --import tsx scripts/verify-import.ts",
    "auth:verify:remote": "node --env-file=.env.local --import tsx scripts/verify-admin-auth.ts",
    "resources:seed": "node --import tsx scripts/generate-official-seed.ts",
    "resources:verify": "node --import tsx scripts/verify-catalog-urls.ts",
    "resources:check": "node --import tsx scripts/check-official-resources.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "latest",
    "@astrojs/sitemap": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tiptap/core": "latest",
    "@tiptap/extension-image": "latest",
    "@tiptap/extension-link": "latest",
    "@tiptap/extension-subscript": "latest",
    "@tiptap/extension-superscript": "latest",
    "@tiptap/extension-table": "latest",
    "@tiptap/html": "latest",
    "@tiptap/pm": "latest",
    "@tiptap/starter-kit": "latest",
    "astro": "latest",
    "marked": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/compiler-binding-darwin-arm64": "0.4.0",
    "@rolldown/binding-darwin-arm64": "1.2.8",
    "@rolldown/binding-wasm32-wasi": "1.2.8",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-astro": "latest",
    "gray-matter": "latest",
    "lightningcss-darwin-arm64": "1.33.0",
    "tsx": "latest",
    "typescript": "^6.0.0",
    "wrangler": "4.131.1"
  }
}
